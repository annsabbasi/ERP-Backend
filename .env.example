# Local development settings. Copy to .env (never commit .env).
# Every value points at the Docker services in infra/docker-compose.yml (docs/local-dev.md).

NODE_ENV=development

# Local-only mode (docs/adr/0007-local-only-until-go-live.md): while set, the api, the worker,
# the seed and every Prisma command refuse any database or Redis URL that is not on this machine.
LOCAL_ONLY=1

# API (apps/api). CORS_ORIGINS: the web app and Platform Console, run from erp-electron.
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# PostgreSQL (packages/db). DIRECT_URL is used for migrations. schema=platform keeps
# Prisma's migration history in the platform schema.
DATABASE_URL=postgresql://erp:erp@localhost:5433/erp?schema=platform
DIRECT_URL=postgresql://erp:erp@localhost:5433/erp?schema=platform
# Hosted databases only: the provider's CA certificate (PEM), if Node does not trust it already.
DATABASE_CA_CERT=

# Redis (apps/worker, queues)
REDIS_URL=redis://localhost:6381

# Object storage (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=erp-minio
S3_SECRET_KEY=erp-minio-local
S3_BUCKET=erp

# Mail (Mailpit; web UI on http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
