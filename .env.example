# Local development settings. Copy to .env (never commit .env).
# Every value points at the Docker services in infra/docker-compose.yml.

NODE_ENV=development

# API (apps/api)
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# PostgreSQL (packages/db). DIRECT_URL is used for migrations. schema=platform keeps
# Prisma's migration history in the platform schema.
DATABASE_URL=postgresql://erp:erp@localhost:5432/erp?schema=platform
DIRECT_URL=postgresql://erp:erp@localhost:5432/erp?schema=platform
# Hosted databases only: the provider's CA certificate (PEM), if Node does not trust it already.
DATABASE_CA_CERT=

# Redis (apps/worker, queues)
REDIS_URL=redis://localhost:6379

# Object storage (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=erp-minio
S3_SECRET_KEY=erp-minio-local
S3_BUCKET=erp

# Mail (Mailpit; web UI on http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025

# Web app (apps/web)
VITE_API_BASE=http://localhost:3000/api/v1
