# Local development settings. Copy to .env (never commit .env).
# Every value points at the Docker services in infra/docker-compose.yml (docs/local-dev.md).

NODE_ENV=development

# Local-only mode (docs/adr/0007-local-only-until-go-live.md): on unless LOCAL_ONLY=0 or
# NODE_ENV=production. While on, the api, the worker, the seed and every Prisma command refuse any
# database or Redis URL that is not on this machine.
LOCAL_ONLY=1

# API (apps/api). CORS_ORIGINS: the web app and Platform Console, run from erp-electron.
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Base of the RFC 9457 problem `type` URIs; set to the docs site once the domain (D3) is chosen.
PROBLEM_TYPE_BASE=https://erp.invalid/problems/

# Sign-in (Part 10 §10.6, ADR 0008). API_URL is the token issuer; WEB_URL and CONSOLE_URL build the
# links in e-mails. AUTH_COOKIE_DOMAIN stays empty until the domain is chosen (D3), so the refresh
# cookie belongs to the API host. AUTH_JWKS (signing keys) and AUTH_ENCRYPTION_KEY are secrets:
# `pnpm local:up` writes local ones into .env (auth:init); hosted environments set their own.
API_URL=http://localhost:3000
WEB_URL=http://localhost:5173
CONSOLE_URL=http://localhost:5174
AUTH_COOKIE_DOMAIN=

# PostgreSQL (packages/db, Part 10 §10.5.3). schema=platform keeps Prisma's migration history in
# the platform schema. Local passwords only; `pnpm local:up` gives the roles these passwords.
#   DATABASE_URL      app_user: the api and the worker. No BYPASSRLS: every app.* query runs under RLS.
#   DIRECT_URL        the database owner: migrations, the seed and the catalogue sync.
#   OPS_DATABASE_URL  app_ops: BYPASSRLS, granted only what the current jobs use (today: outbox dispatch).
#   AUTH_DATABASE_URL app_auth: the auth module only; sign-in secrets, no tenant data (ADR 0008).
DATABASE_URL=postgresql://app_user:app_user_local@localhost:5433/erp?schema=platform
DIRECT_URL=postgresql://erp:erp@localhost:5433/erp?schema=platform
OPS_DATABASE_URL=postgresql://app_ops:app_ops_local@localhost:5433/erp?schema=platform
AUTH_DATABASE_URL=postgresql://app_auth:app_auth_local@localhost:5433/erp?schema=platform
# Hosted databases only: the provider's CA certificate (PEM), if Node does not trust it already.
DATABASE_CA_CERT=

# Redis (apps/worker, queues)
REDIS_URL=redis://localhost:6381

# Object storage (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=erp-minio
S3_SECRET_KEY=erp-minio-local
S3_BUCKET=erp

# Mail (D4): the worker sends over SMTP. Locally Mailpit catches everything (http://localhost:8025).
MAIL_SMTP_URL=smtp://localhost:1025
MAIL_FROM=ERP System <no-reply@erp.invalid>
