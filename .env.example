# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3070
NODE_ENV=development

# CORS — set to your frontend origin in production. '*' is fine for local dev
# but must be tightened before shipping, since credentials are allowed.
CORS_ORIGIN=*

# Serve /docs (OpenAPI) in production. Off unless explicitly enabled.
# ENABLE_SWAGGER=true

# ─── Database (Supabase Postgres) ─────────────────────────────────────────────
# DATABASE_URL goes through the PgBouncer pooler and is what the app uses.
# DIRECT_URL bypasses the pooler and is what `prisma migrate` needs — migrations
# cannot run over PgBouncer.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connect_timeout=15
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Required in production — the app refuses to boot without it.
JWT_SECRET=replace_with_openssl_rand_hex_32
# Access tokens are short-lived; refresh tokens are stored hashed in the DB.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Account lockout policy ───────────────────────────────────────────────────
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_FAILED_ATTEMPT_WINDOW_MINUTES=15

# ─── Notifications ────────────────────────────────────────────────────────────
# Leave SMTP_HOST blank to disable email delivery (messages are logged instead).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@erp.local

WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_TIMEOUT_MS=5000

# ─── Document storage ─────────────────────────────────────────────────────────
# 'local' writes to STORAGE_LOCAL_PATH. Note that serverless hosts (Vercel) have
# an ephemeral filesystem, so use 's3' there or uploads will vanish between
# invocations.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_MAX_UPLOAD_BYTES=52428800

# Only needed when STORAGE_DRIVER=s3 (Supabase Storage is S3-compatible).
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
