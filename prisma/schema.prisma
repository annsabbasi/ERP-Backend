generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── SYSTEM MODULES ───────────────────────────────────────────────────────────
// Platform-level modules available to be assigned to companies (set by super admin)
model SystemModule {
  id          String   @id @default(uuid())
  name        String   @unique  // "HR", "Financials", "CRM" …
  slug        String   @unique  // "hr", "financials", "crm" …
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  companyModules CompanyModule[]
  userModules    UserModule[]
  planModules    PlanModule[]

  @@map("system_modules")
}

// ─── COMPANIES (TENANTS) ──────────────────────────────────────────────────────
model Company {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique  // used in login: "acme-corp"
  logoUrl         String?
  isActive        Boolean  @default(true)

  // Tenancy profile (Section 4.1).
  industry        String?  // template key: "generic" | "construction" | "real_estate" | ...
  country         String?  // ISO-3166 alpha-2
  currency        String?  // ISO-4217 (e.g. "USD")
  locale          String?  // e.g. "en-US"
  timezone        String?  // IANA TZ
  fiscalYearStart Int?     // 1-12 (month index)

  // Per-tenant branding & terminology overrides
  // { primaryColor, terminologyOverrides: { "Project": "Site", "Customer": "Resident" }, ... }
  branding        Json?

  templateApplied String?  // last industry template applied (for audit / re-apply)

  // Accounting defaults (Section 6.5) — control accounts referenced by AR/AP
  // posting. All optional; set per company once the CoA is in place.
  defaultArAccountId             String?
  defaultApAccountId             String?
  defaultCashAccountId           String?
  defaultTaxPayableAccountId     String?
  defaultTaxRecoverableAccountId String?
  defaultRevenueAccountId        String?
  defaultExpenseAccountId        String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users            User[]
  roles            Role[]
  permissionSets   PermissionSet[]
  companyModules   CompanyModule[]
  departments      Department[]
  branches         Branch[]
  employees        Employee[]
  products         Product[]
  inventoryItems   InventoryItem[]
  orders           Order[]
  invoices         Invoice[]
  subscription        Subscription?
  billingInvoices     BillingInvoice[]
  workflowDefinitions WorkflowDefinition[]
  workflowInstances   WorkflowInstance[]
  webhookEndpoints    WebhookEndpoint[]
  folders             Folder[]
  documents           Document[]
  positions           Position[]
  leaveTypes          LeaveType[]
  leaveRequests       LeaveRequest[]
  shifts              Shift[]
  attendanceEntries   AttendanceEntry[]
  onboardingTemplates OnboardingTemplate[]
  onboardingInstances OnboardingInstance[]
  accounts            Account[]
  fiscalPeriods       FiscalPeriod[]
  journalEntries      JournalEntry[]
  exchangeRates       ExchangeRate[]
  businessPartners    BusinessPartner[]
  paymentTerms        PaymentTerms[]
  arInvoices          ARInvoice[]
  arPayments          ARPayment[]
  apBills             APBill[]
  apPayments          APPayment[]

  // ── Administration (Section 6.13) ──
  settings              CompanySetting[]
  numberingSeries       NumberingSeries[]
  documentSettings      DocumentSetting[]
  userGroups            UserGroup[]
  userDefaultsGroups    UserDefaultsGroup[]
  predefinedTexts       PredefinedText[]
  countries             Country[]
  alertDefinitions      AlertDefinition[]
  approvalStages        ApprovalStage[]
  approvalTemplates     ApprovalTemplate[]
  approvalRequests      ApprovalRequest[]
  substituteAuthorizers SubstituteAuthorizer[]

  // ── CRM (Section 6.14) ──
  bpGroups              BusinessPartnerGroup[]
  territories           Territory[]
  salesEmployees        SalesEmployee[]
  commissionGroups      CommissionGroup[]
  activities            Activity[]
  opportunities         Opportunity[]
  opportunityStageDefs  OpportunityStageDef[]
  competitors           Competitor[]
  crmPartners           CrmPartner[]
  informationSources    InformationSource[]
  campaigns             Campaign[]
  bpRelationships       BpRelationshipType[]

  // ── Financials setup & cost accounting (Section 6.15) ──
  accountDeterminations AccountDetermination[]
  postingTemplates      PostingTemplate[]
  recurringPostings     RecurringPosting[]
  financeProjects       FinanceProject[]
  transactionCodes      TransactionCode[]
  taxCodes              TaxCode[]
  dimensions            Dimension[]
  costCenters           CostCenter[]
  distributionRules     DistributionRule[]
  budgetScenarios       BudgetScenario[]
  budgetDistributions   BudgetDistributionMethod[]
  budgetLines           BudgetLine[]
  cashFlowLineItems     CashFlowLineItem[]
  currencies            Currency[]
  dunningTerms          DunningTerm[]
  paymentMethods        PaymentMethod[]
  banks                 Bank[]
  houseBankAccounts     HouseBankAccount[]
  fixedAssets           FixedAsset[]
  internalReconciliations InternalReconciliation[]
  attachments           Attachment[]

  @@map("companies")
}

// ─── BRANCHES ─────────────────────────────────────────────────────────────────
// Optional sub-division of a Company (regional offices, separate sites).
// Inherits company configuration; users and resources can be branch-scoped.
model Branch {
  id        String   @id @default(uuid())
  companyId String
  name      String
  code      String?  // company-defined short code (e.g. "NYC", "PK-LHE")
  address   String?
  managerId String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager     User?        @relation("BranchManager", fields: [managerId], references: [id])
  users       User[]       @relation("UserBranch")
  departments Department[]
  employees   Employee[]   @relation("EmployeeBranch")
  positions   Position[]   @relation("PositionBranch")

  @@unique([companyId, name])
  @@index([companyId])
  @@map("branches")
}

// ─── COMPANY ↔ MODULE ─────────────────────────────────────────────────────────
model CompanyModule {
  id         String   @id @default(uuid())
  companyId  String
  moduleId   String
  isEnabled  Boolean  @default(true)
  assignedAt DateTime @default(now())

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module  SystemModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([companyId, moduleId])
  @@map("company_modules")
}

// Four-tier hierarchy from the master spec (Section 5.1).
//   SUPER_ADMIN     — platform owner; lives outside any company (companyId = null)
//   COMPANY_ADMIN   — highest authority within a single company
//   DEPARTMENT_HEAD — runs a department; manages employees in it
//   EMPLOYEE        — limited to own data + role-assigned modules
enum UserRoleType {
  SUPER_ADMIN
  COMPANY_ADMIN
  DEPARTMENT_HEAD
  EMPLOYEE
}

// ─── USERS ────────────────────────────────────────────────────────────────────
// companyId is null for platform-level super admins
model User {
  id           String    @id @default(uuid())
  email        String
  name         String
  passwordHash String
  companyId    String?
  roleType     UserRoleType @default(EMPLOYEE)
  departmentId String?
  branchId     String?
  isSuperAdmin Boolean   @default(false)
  isActive     Boolean   @default(true)

  // Administration → Setup → General → User Defaults. A defaults group seeds
  // per-user preferences (default warehouse, series, print prefs, …).
  userDefaultsGroupId String?

  // Auth lifecycle (Section 6.1 — IAM)
  mfaEnabled            Boolean   @default(false)
  mfaSecret             String?   // TOTP secret; populated when MFA is enrolled
  lastLoginAt           DateTime?
  lockedUntil           DateTime? // set after repeated failed logins
  failedLoginAttempts   Int       @default(0)
  passwordChangedAt     DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  company               Company?                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department            Department?              @relation(fields: [departmentId], references: [id])
  branch                Branch?                  @relation("UserBranch", fields: [branchId], references: [id])
  managedBranches       Branch[]                 @relation("BranchManager")
  userRoles             UserRole[]
  userModules           UserModule[]
  refreshTokens         RefreshToken[]
  authEvents            AuthEvent[]
  notifications         Notification[]
  notificationPreferences NotificationPreference[]

  userDefaultsGroup     UserDefaultsGroup?       @relation(fields: [userDefaultsGroupId], references: [id])
  userGroupMemberships  UserGroupMember[]
  salesEmployee         SalesEmployee?
  ownedActivities       Activity[]               @relation("ActivityOwner")
  assignedActivities    Activity[]               @relation("ActivityAssignee")
  approvalStageMemberships ApprovalStageApprover[]
  approvalTemplateOriginations ApprovalTemplateOriginator[]
  approvalRequestsRaised ApprovalRequest[]       @relation("ApprovalOriginator")
  approvalDecisions     DocumentApprovalDecision[]
  substitutedFor        SubstituteAuthorizer[]   @relation("SubstituteOriginal")
  substituting          SubstituteAuthorizer[]   @relation("SubstituteStandIn")
  alertSubscriptions    AlertSubscription[]
  alertInstances        AlertInstance[]
  uploadedAttachments   Attachment[]

  @@unique([email, companyId])
  @@index([companyId])
  @@index([branchId])
  @@map("users")
}

// ─── AUTH: REFRESH TOKENS ─────────────────────────────────────────────────────
// We store the SHA-256 hash of the refresh token, never the raw token.
// On refresh, we rotate (revoke current, issue a new one and link via replacedBy).
model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @unique
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id])
  replaces   RefreshToken? @relation("TokenRotation")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ─── AUTH: LOGIN ATTEMPTS ─────────────────────────────────────────────────────
// One row per attempt (success or failure). Drives lockout and security alerts.
model LoginAttempt {
  id            String   @id @default(uuid())
  email         String
  companySlug   String?
  userId        String?  // null for unknown email or wrong company
  success       Boolean
  failureReason String?  // 'invalid_credentials' | 'locked' | 'inactive' | 'unknown_company'
  ip            String?
  userAgent     String?
  attemptedAt   DateTime @default(now())

  @@index([email])
  @@index([userId])
  @@index([attemptedAt])
  @@map("login_attempts")
}

// ─── AUTH: AUTH EVENTS ────────────────────────────────────────────────────────
// Lifecycle events for compliance and audit (Section 13.1).
enum AuthEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  TOKEN_REFRESHED
  TOKEN_REVOKED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  PASSWORD_CHANGED
  MFA_ENROLLED
  MFA_DISABLED
}

model AuthEvent {
  id        String        @id @default(uuid())
  userId    String?
  type      AuthEventType
  ip        String?
  userAgent String?
  metadata  Json?
  at        DateTime      @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([at])
  @@map("auth_events")
}

model UserModule {
  userId     String
  moduleId   String
  assignedAt DateTime @default(now())

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  module SystemModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([userId, moduleId])
  @@map("user_modules")
}

// ─── ROLES (PER COMPANY) ──────────────────────────────────────────────────────
// A Role is a named bundle of permissions, scoped to a Company. Roles can be
// composed of one or more PermissionSets plus individual Permission overrides
// (Section 5.3). Cloning is first-class: `sourceRoleId` records provenance.
model Role {
  id           String          @id @default(uuid())
  name         String
  description  String?
  companyId    String
  domain       String?         // null = general; "HR" = HR-domain role; "FINANCE" etc.
  isDefault    Boolean         @default(false)
  defaultScope PermissionScope @default(ALL)
  sourceRoleId String?         // populated when this role was cloned from another
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userRoles          UserRole[]
  rolePermissions    RolePermission[]
  rolePermissionSets RolePermissionSet[]
  sourceRole         Role?               @relation("RoleClone", fields: [sourceRoleId], references: [id])
  clones             Role[]              @relation("RoleClone")

  @@unique([name, companyId])
  @@index([companyId])
  @@map("roles")
}

// ─── USER ↔ ROLE ──────────────────────────────────────────────────────────────
model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ─── PERMISSIONS ──────────────────────────────────────────────────────────────
// Platform-defined catalog of capabilities (Section 5.3). Identifiers follow
// resource.action — e.g. "hr.employee.create", "finance.invoice.read".
// `moduleSlug` is denormalized (no FK) so we can ship permissions for a
// module before the SystemModule row exists.
model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  resource    String
  action      String
  moduleSlug  String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
  setItems        PermissionSetItem[]

  @@index([moduleSlug])
  @@index([resource])
  @@map("permissions")
}

// ─── PERMISSION SCOPE ─────────────────────────────────────────────────────────
// Captures the data-scope qualifier from Section 5.5: a holder of "view"
// at scope DEPARTMENT can only see records in their department, etc.
enum PermissionScope {
  OWN
  DEPARTMENT
  BRANCH
  ALL
}

// ─── PERMISSION SETS ──────────────────────────────────────────────────────────
// Reusable bundles of (permission, scope) pairs that compose into Roles.
// System sets are platform-wide templates ("hr.viewer", "hr.standard", etc.);
// company sets are tenant-defined for organization-specific job functions.
model PermissionSet {
  id          String   @id @default(uuid())
  key         String?  @unique  // populated only for system sets
  name        String
  description String?
  isSystem    Boolean  @default(false)
  companyId   String?  // null when isSystem; required for custom sets
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company           Company?            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items             PermissionSetItem[]
  rolePermissionSets RolePermissionSet[]

  @@unique([name, companyId])
  @@map("permission_sets")
}

model PermissionSetItem {
  id           String          @id @default(uuid())
  setId        String
  permissionId String
  scope        PermissionScope @default(ALL)

  set        PermissionSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  permission Permission    @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([setId, permissionId, scope])
  @@map("permission_set_items")
}

// ─── ROLE ↔ PERMISSION ────────────────────────────────────────────────────────
// Direct (per-permission) assignment of capabilities to a role, with scope.
// Same role may also inherit permissions via attached PermissionSets — the
// resolver merges both, taking the broadest scope per key.
model RolePermission {
  id           String          @id @default(uuid())
  roleId       String
  permissionId String
  scope        PermissionScope @default(ALL)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId, scope])
  @@index([roleId])
  @@map("role_permissions")
}

// ─── ROLE ↔ PERMISSION SET ────────────────────────────────────────────────────
model RolePermissionSet {
  roleId String
  setId  String

  role Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  set  PermissionSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@id([roleId, setId])
  @@map("role_permission_sets")
}

// ─── DEPARTMENTS ──────────────────────────────────────────────────────────────
model Department {
  id          String   @id @default(uuid())
  companyId   String
  branchId    String?
  name        String
  description String?
  createdAt   DateTime @default(now())

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch    Branch?    @relation(fields: [branchId], references: [id])
  employees Employee[]
  users     User[]
  positions Position[]

  @@unique([name, companyId])
  @@index([companyId])
  @@index([branchId])
  @@map("departments")
}

// ─── EMPLOYEES (Section 6.3) ──────────────────────────────────────────────────
enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
  RETIRED
  SUSPENDED
}

model Employee {
  id              String         @id @default(uuid())
  companyId       String
  // Optional link to a User account — populated when the employee has system
  // login. Field workers, retirees, etc. may have an Employee row but no User.
  userId          String?        @unique
  employeeNumber  String?
  name            String
  email           String?
  phone           String?
  departmentId    String?
  branchId        String?
  positionId      String?
  managerId       String?        // self-ref for org chart
  hireDate        DateTime?
  terminationDate DateTime?
  status          EmployeeStatus @default(ACTIVE)
  customFields    Json?
  // Legacy quick-access salary — superseded by EmploymentContract.salaryAmountMinor.
  // Kept for back-compat with the skeletal scaffold; new code should write
  // contracts and read `currentContract` instead.
  salary          Decimal?       @db.Decimal(12, 2)
  // Mirror legacy position string for back-compat; positionId is canonical.
  position        String?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department          Department?          @relation(fields: [departmentId], references: [id])
  branch              Branch?              @relation("EmployeeBranch", fields: [branchId], references: [id])
  positionRef         Position?            @relation(fields: [positionId], references: [id])
  manager             Employee?            @relation("EmployeeManager", fields: [managerId], references: [id])
  reports             Employee[]           @relation("EmployeeManager")
  contracts           EmploymentContract[]
  attendance          AttendanceEntry[]
  leaveBalances       LeaveBalance[]
  leaveRequests       LeaveRequest[]
  shiftAssignments    EmployeeShift[]
  onboardingInstances OnboardingInstance[]
  salesEmployee       SalesEmployee?

  @@index([companyId])
  @@index([branchId])
  @@index([managerId])
  @@index([positionId])
  @@map("employees")
}

// ─── POSITIONS ────────────────────────────────────────────────────────────────
// Per-company job catalog. Employees can hold one position at a time.
model Position {
  id           String   @id @default(uuid())
  companyId    String
  title        String
  code         String?
  description  String?
  level        Int?
  departmentId String?
  branchId     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department?          @relation(fields: [departmentId], references: [id])
  branch     Branch?              @relation("PositionBranch", fields: [branchId], references: [id])
  employees  Employee[]
  contracts  EmploymentContract[]

  @@unique([companyId, title])
  @@index([companyId])
  @@map("positions")
}

// ─── EMPLOYMENT CONTRACTS ─────────────────────────────────────────────────────
enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  TEMPORARY
  CONSULTANT
}

model EmploymentContract {
  id                String         @id @default(uuid())
  employeeId        String
  positionId        String?
  type              EmploymentType
  startDate         DateTime
  endDate           DateTime?
  // Monetary fields use integer minor units + currency code (Section 14.1).
  salaryAmountMinor Int?
  salaryCurrency    String?        @default("USD")
  // "MONTHLY" | "ANNUAL" | "HOURLY" | "DAILY" — kept as string to allow custom.
  salaryFrequency   String?
  workHoursPerWeek  Int?
  notes             String?
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  employee Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  position Position? @relation(fields: [positionId], references: [id])

  @@index([employeeId])
  @@map("employment_contracts")
}

// ─── LEAVE TYPES + BALANCES + REQUESTS ────────────────────────────────────────
enum LeaveAccrualMode {
  NONE
  PERIODIC
}

model LeaveType {
  id               String           @id @default(uuid())
  companyId        String
  code             String           // "ANNUAL" | "SICK" | "UNPAID" | …
  name             String
  description      String?
  accrualMode      LeaveAccrualMode @default(NONE)
  // Days accrued per period (when accrualMode = PERIODIC).
  accrualDays      Decimal?         @db.Decimal(6, 2)
  // "MONTHLY" | "YEARLY" | "PAY_PERIOD" — interpreted by the accrual runner.
  accrualPeriod    String?
  maxBalance       Decimal?         @db.Decimal(6, 2)
  paid             Boolean          @default(true)
  requiresApproval Boolean          @default(true)
  workflowKey      String?          // workflow definition key (default "leave_request")
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  balances LeaveBalance[]
  requests LeaveRequest[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("leave_types")
}

// Running balance for an employee × leaveType × period (e.g. "2026").
model LeaveBalance {
  id            String   @id @default(uuid())
  employeeId    String
  leaveTypeId   String
  periodKey     String
  accruedDays   Decimal  @db.Decimal(6, 2) @default(0)
  usedDays      Decimal  @db.Decimal(6, 2) @default(0)
  pendingDays   Decimal  @db.Decimal(6, 2) @default(0)
  carryOverDays Decimal  @db.Decimal(6, 2) @default(0)
  updatedAt     DateTime @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, periodKey])
  @@index([employeeId])
  @@map("leave_balances")
}

enum LeaveRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  TAKEN
}

model LeaveRequest {
  id                 String             @id @default(uuid())
  companyId          String
  employeeId         String
  leaveTypeId        String
  startDate          DateTime
  endDate            DateTime
  // Fractional days for half-day support.
  days               Decimal            @db.Decimal(6, 2)
  reason             String?
  status             LeaveRequestStatus @default(PENDING)
  workflowInstanceId String?
  approvedById       String?
  approvedAt         DateTime?
  rejectedReason     String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([companyId])
  @@index([employeeId, status])
  @@map("leave_requests")
}

// ─── SHIFTS + ATTENDANCE ──────────────────────────────────────────────────────
model Shift {
  id           String   @id @default(uuid())
  companyId    String
  code         String
  name         String
  // 24-hour HH:MM strings, interpreted in the company timezone.
  startTime    String
  endTime      String
  isOvernight  Boolean  @default(false)
  breakMinutes Int      @default(0)
  // 0=Sunday … 6=Saturday
  workDays     Int[]
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments EmployeeShift[]

  @@unique([companyId, code])
  @@map("shifts")
}

model EmployeeShift {
  id            String    @id @default(uuid())
  employeeId    String
  shiftId       String
  effectiveFrom DateTime
  effectiveTo   DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_shifts")
}

enum AttendanceSource {
  WEB
  DESKTOP
  MOBILE
  DEVICE
  MANUAL
}

enum AttendanceStatus {
  CHECKED_IN
  CHECKED_OUT
  AUTO_CLOSED
  MISSED
}

// One entry per (employee, date). Late clock-ins update an existing row;
// the daily-summary job auto-closes any open CHECKED_IN rows.
model AttendanceEntry {
  id            String           @id @default(uuid())
  companyId     String
  employeeId    String
  date          DateTime         @db.Date
  checkIn       DateTime?
  checkOut      DateTime?
  source        AttendanceSource @default(WEB)
  status        AttendanceStatus @default(CHECKED_IN)
  workedMinutes Int?
  shiftId       String?
  notes         String?
  ip            String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([companyId, date])
  @@map("attendance_entries")
}

// ─── ONBOARDING ───────────────────────────────────────────────────────────────
enum OnboardingItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

model OnboardingTemplate {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  description String?
  // Optional auto-apply: when an employee with this position is created.
  positionId  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items     OnboardingTemplateItem[]
  instances OnboardingInstance[]

  @@unique([companyId, name])
  @@map("onboarding_templates")
}

model OnboardingTemplateItem {
  id            String   @id @default(uuid())
  templateId    String
  title         String
  description   String?
  // "documents" | "equipment" | "training" | "system_access" | …
  category      String?
  // "manager" | "hr" | "it" | "employee" — resolved when an instance is spawned.
  assigneeRole  String?
  daysFromStart Int?     // SLA relative to hire date
  ordering      Int      @default(0)

  template OnboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("onboarding_template_items")
}

model OnboardingInstance {
  id          String    @id @default(uuid())
  companyId   String
  employeeId  String
  templateId  String?
  startedAt   DateTime  @default(now())
  targetEndAt DateTime?
  completedAt DateTime?

  company  Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  template OnboardingTemplate?      @relation(fields: [templateId], references: [id])
  items    OnboardingInstanceItem[]

  @@index([employeeId])
  @@map("onboarding_instances")
}

model OnboardingInstanceItem {
  id            String               @id @default(uuid())
  instanceId    String
  title         String
  description   String?
  category      String?
  assigneeId    String?              // userId
  status        OnboardingItemStatus @default(PENDING)
  dueAt         DateTime?
  completedAt   DateTime?
  completedById String?
  notes         String?

  instance OnboardingInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@index([assigneeId, status])
  @@map("onboarding_instance_items")
}

// ─── PRODUCTS ─────────────────────────────────────────────────────────────────
model Product {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  sku         String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem?
  orderItems    OrderItem[]

  @@index([companyId])
  @@map("products")
}

// ─── INVENTORY ────────────────────────────────────────────────────────────────
model InventoryItem {
  id                String   @id @default(uuid())
  companyId         String
  productId         String   @unique
  quantity          Int      @default(0)
  warehouseLocation String?
  lastUpdated       DateTime @default(now()) @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("inventory_items")
}

// ─── ORDERS ───────────────────────────────────────────────────────────────────
model Order {
  id        String      @id @default(uuid())
  companyId String
  status    OrderStatus @default(PENDING)
  total     Decimal     @default(0) @db.Decimal(12, 2)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  company  Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items    OrderItem[]
  invoices Invoice[]

  @@index([companyId])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// ─── INVOICES ─────────────────────────────────────────────────────────────────
model Invoice {
  id        String        @id @default(uuid())
  companyId String
  orderId   String?
  status    InvoiceStatus @default(DRAFT)
  total     Decimal       @default(0) @db.Decimal(12, 2)
  dueDate   DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order   Order?        @relation(fields: [orderId], references: [id])
  lines   InvoiceLine[]

  @@index([companyId])
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model InvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_lines")
}

// ─── ACTIVITY LOGS ────────────────────────────────────────────────────────────
// High-volume informational log (Section 6.12). For audit-grade records that
// need before/after snapshots and tamper-evidence, see AuditEvent below.
model ActivityLog {
  id        String   @id @default(uuid())
  companyId String?
  userId    String?
  action    String
  module    String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

// ─── AUDIT EVENTS ─────────────────────────────────────────────────────────────
// Immutable, append-only audit log for sensitive operations (Section 6.12).
//
//   • `before` / `after` capture entity snapshots for change forensics.
//   • `hash` is a SHA-256 of the canonicalized record content.
//   • `chainHash` links to the previous event's `hash` for the same company —
//     a tamper attempt requires rewriting the chain from that point forward.
//   • Records here have a long retention by default (7 years) and are only
//     ever deleted via the RetentionPolicy enforcement runner.
model AuditEvent {
  id          String   @id @default(uuid())
  companyId   String?
  actorId     String?
  action      String   // canonical event key, e.g. "role.created"
  refType     String?  // e.g. "role", "subscription", "user"
  refId       String?
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?
  requestId   String?
  hash        String   // SHA-256 of canonical(record)
  chainHash   String?  // hash of the prior event for this company
  at          DateTime @default(now())

  @@index([companyId, at])
  @@index([actorId])
  @@index([refType, refId])
  @@index([action])
  @@map("audit_events")
}

// ─── RETENTION POLICY ─────────────────────────────────────────────────────────
// Per-dataClass retention windows (Section 13.5). The RetentionService reads
// these and deletes records older than `retentionDays`.
model RetentionPolicy {
  id            String   @id @default(uuid())
  dataClass     String   @unique
  retentionDays Int
  isEnforced    Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("retention_policies")
}

// ─── PLANS (Subscription tiers — Section 4.2) ─────────────────────────────────
model Plan {
  id            String   @id @default(uuid())
  key           String   @unique  // "starter" | "business" | "premium" | "enterprise"
  name          String
  description   String?
  isPublic      Boolean  @default(true)   // shown in self-service signup
  isActive      Boolean  @default(true)
  monthlyPrice  Int?     // minor units (cents) — null = custom-quoted
  annualPrice   Int?     // minor units
  currency      String   @default("USD")
  maxUsers      Int?     // null = unlimited (Enterprise)
  trialDays     Int      @default(14)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  modules       PlanModule[]
  subscriptions Subscription[]

  @@map("plans")
}

// Modules included in a plan. A subscription's effective module set is the
// union of (PlanModule for plan) — used to gate company module activation.
model PlanModule {
  planId   String
  moduleId String

  plan   Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  module SystemModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([planId, moduleId])
  @@map("plan_modules")
}

// ─── SUBSCRIPTIONS ────────────────────────────────────────────────────────────
enum BillingInterval {
  MONTHLY
  ANNUAL
}

// Lifecycle from Section 4.4:
//   trial → active → past_due → suspended → cancelled → archived
//                  ↘ active (on payment)    ↗ active (manual reactivation)
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  ARCHIVED
}

model Subscription {
  id                  String             @id @default(uuid())
  companyId           String             @unique
  planId              String
  status              SubscriptionStatus @default(TRIAL)
  billingInterval     BillingInterval    @default(MONTHLY)
  // Period boundaries (manually set; integrate with Stripe later).
  trialEndsAt         DateTime?
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  // Lifecycle audit timestamps.
  startedAt           DateTime           @default(now())
  pastDueAt           DateTime?
  suspendedAt         DateTime?
  cancelledAt         DateTime?
  archivedAt          DateTime?
  // Per-tenant overrides on the plan defaults.
  seatsOverride       Int?               // null = use plan.maxUsers
  autoRenew           Boolean            @default(true)
  notes               String?

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan              @relation(fields: [planId], references: [id])
  events  SubscriptionEvent[]
  invoices BillingInvoice[]

  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

model SubscriptionEvent {
  id             String              @id @default(uuid())
  subscriptionId String
  fromStatus     SubscriptionStatus?
  toStatus       SubscriptionStatus
  reason         String?
  actorId        String?              // null = system
  occurredAt     DateTime             @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("subscription_events")
}

// ─── BILLING INVOICES (manual; Stripe integration deferred) ───────────────────
enum BillingInvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
  REFUNDED
}

model BillingInvoice {
  id              String               @id @default(uuid())
  companyId       String
  subscriptionId  String?
  number          String               @unique
  status          BillingInvoiceStatus @default(DRAFT)
  amountMinor     Int                  // total in minor units (e.g. cents)
  currency        String               @default("USD")
  periodStart     DateTime?
  periodEnd       DateTime?
  issuedAt        DateTime?
  dueAt           DateTime?
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription Subscription?   @relation(fields: [subscriptionId], references: [id])
  payments     BillingPayment[]

  @@index([companyId])
  @@index([subscriptionId])
  @@map("billing_invoices")
}

model BillingPayment {
  id          String   @id @default(uuid())
  invoiceId   String
  amountMinor Int
  currency    String   @default("USD")
  method      String?  // "manual" | "stripe" | "wire" — string to avoid lock-in
  reference   String?
  receivedAt  DateTime @default(now())

  invoice BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("billing_payments")
}

// ─── WORKFLOW ENGINE (Sections 6.10 + 9) ──────────────────────────────────────
//
// Definitions are versioned, declarative step graphs (stored as JSON). System
// templates have companyId = null + isSystem = true and can be cloned into a
// company's own version. Instances reference the immutable (definitionId,
// version) pair so a running instance never sees an unexpected step rewrite.

enum WorkflowStatus {
  PENDING
  RUNNING
  AWAITING_APPROVAL
  WAITING
  COMPLETED
  REJECTED
  CANCELLED
  ERRORED
}

enum WorkflowStepType {
  APPROVAL
  AUTOMATED_ACTION
  CONDITIONAL_BRANCH
  WAIT
  ESCALATION
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum ApprovalSemantics {
  FIRST_RESPONSE
  UNANIMOUS
  MAJORITY
}

model WorkflowDefinition {
  id          String   @id @default(uuid())
  companyId   String?  // null = system template
  key         String   // domain-stable identifier (e.g. "leave_request")
  name        String
  description String?
  entityType  String?  // optional — what kind of entity this workflow operates on
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  isSystem    Boolean  @default(false)
  steps       Json     // serialized step graph (typed in TS)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  instances WorkflowInstance[]

  @@unique([companyId, key, version])
  @@index([companyId])
  @@map("workflow_definitions")
}

model WorkflowInstance {
  id            String         @id @default(uuid())
  definitionId  String
  companyId     String
  initiatorId   String?
  refType       String?
  refId         String?
  status        WorkflowStatus @default(PENDING)
  currentStepKey String?
  context       Json?
  resumeAt      DateTime?      // for WAIT steps
  startedAt     DateTime       @default(now())
  completedAt   DateTime?

  definition WorkflowDefinition     @relation(fields: [definitionId], references: [id])
  company    Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  history    WorkflowHistoryEntry[]
  approvals  WorkflowApproval[]

  @@index([companyId, status])
  @@index([definitionId])
  @@index([refType, refId])
  @@index([resumeAt])
  @@map("workflow_instances")
}

model WorkflowHistoryEntry {
  id         String   @id @default(uuid())
  instanceId String
  stepKey    String
  stepType   WorkflowStepType
  status     String   // entered | completed | errored | rejected | approved | cancelled
  actorId    String?
  message    String?
  metadata   Json?
  occurredAt DateTime @default(now())

  instance WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@map("workflow_history")
}

model WorkflowApproval {
  id         String            @id @default(uuid())
  instanceId String
  stepKey    String
  approverId String
  decision   ApprovalDecision?
  comment    String?
  decidedAt  DateTime?
  createdAt  DateTime          @default(now())

  instance WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, stepKey, approverId])
  @@index([approverId, decision])
  @@map("workflow_approvals")
}

// ─── NOTIFICATIONS (Section 6.10) ─────────────────────────────────────────────
//
// In-app is always available; other channels gate on per-user prefs and
// per-channel adapter configuration. The `category` field is a stable string
// taxonomy (e.g. "workflow.approval", "billing.invoice_issued") that drives
// both per-channel routing and webhook filtering.

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
  PUSH
  DESKTOP_TOAST
}

enum NotificationDigest {
  IMMEDIATE
  HOURLY
  DAILY
  WEEKLY
  OFF
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
  DISMISSED
}

model Notification {
  id            String              @id @default(uuid())
  companyId     String?
  userId        String
  channel       NotificationChannel
  category      String              // "workflow.approval", "auth.login_alert", …
  subject       String?
  body          String
  data          Json?               // deep-link payload, refIds, etc.
  refType       String?
  refId         String?
  status        NotificationStatus  @default(PENDING)
  sentAt        DateTime?
  readAt        DateTime?
  dismissedAt   DateTime?
  failureReason String?
  createdAt     DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([companyId])
  @@index([category])
  @@index([createdAt])
  @@map("notifications")
}

// Per-user × category × channel preference. `category = "*"` is the fallback
// applied when no more specific preference matches.
model NotificationPreference {
  id       String              @id @default(uuid())
  userId   String
  category String              @default("*")
  channel  NotificationChannel
  enabled  Boolean             @default(true)
  digest   NotificationDigest  @default(IMMEDIATE)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, channel])
  @@map("notification_preferences")
}

// ─── WEBHOOKS (outbound event bus — Section 6.10) ─────────────────────────────
enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  RETRYING
}

model WebhookEndpoint {
  id           String   @id @default(uuid())
  companyId    String
  name         String
  url          String
  secret       String   // shared secret for HMAC-SHA256 signature
  eventFilters String[] // glob-ish patterns; empty = all events
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([companyId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id              String                @id @default(uuid())
  endpointId      String
  eventKey        String                // mirrors Notification.category style
  payload         Json
  status          WebhookDeliveryStatus @default(PENDING)
  attempts        Int                   @default(0)
  responseStatus  Int?
  responseBody    String?
  errorMessage    String?
  lastAttemptedAt DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime              @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, status])
  @@index([eventKey])
  @@map("webhook_deliveries")
}

// ─── DOCUMENT MANAGEMENT (Section 6.9) ────────────────────────────────────────
//
// Folder hierarchy is per-company; folder names are unique within their
// parent. Documents live in (at most) one folder and point to an immutable
// chain of DocumentVersions stored in object storage.
//
// Cross-tenant isolation is enforced at two levels:
//   • Every query is scoped by companyId via TenantContext.
//   • Storage keys live under a `companies/{companyId}/...` prefix so a
//     misrouted SDK call can't reach another tenant's bytes.

model Folder {
  id          String   @id @default(uuid())
  companyId   String
  parentId    String?
  name        String
  description String?
  createdById String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent    Folder?    @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children  Folder[]   @relation("FolderHierarchy")
  documents Document[]

  @@unique([companyId, parentId, name])
  @@index([companyId])
  @@index([parentId])
  @@map("folders")
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

model Document {
  id               String         @id @default(uuid())
  companyId        String
  folderId         String?
  name             String
  description      String?
  mimeType         String
  size             Int            // bytes — mirrors currentVersion.size for fast list queries
  status           DocumentStatus @default(ACTIVE)
  currentVersionId String?        @unique
  ownerId          String?
  refType          String?        // optional polymorphic link (e.g. "hr.employee", "finance.invoice")
  refId            String?
  tags             String[]
  metadata         Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  folder         Folder?             @relation(fields: [folderId], references: [id])
  versions       DocumentVersion[]   @relation("DocumentVersions")
  currentVersion DocumentVersion?    @relation("DocumentCurrentVersion", fields: [currentVersionId], references: [id])
  accessLogs     DocumentAccessLog[]
  shareLinks     ShareLink[]

  @@index([companyId, status])
  @@index([folderId])
  @@index([refType, refId])
  @@map("documents")
}

model DocumentVersion {
  id            String   @id @default(uuid())
  documentId    String
  versionNumber Int
  storageKey    String   // pointer into object storage
  size          Int
  checksum      String   // SHA-256 hex
  mimeType      String
  uploadedById  String?
  uploadedAt    DateTime @default(now())
  notes         String?

  document      Document  @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  currentOf     Document? @relation("DocumentCurrentVersion")

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@map("document_versions")
}

enum DocumentAccessType {
  VIEWED
  DOWNLOADED
  PREVIEWED
  SHARED_LINK_OPENED
}

model DocumentAccessLog {
  id          String             @id @default(uuid())
  documentId  String
  userId      String?            // null for external share-link opens
  accessType  DocumentAccessType
  shareLinkId String?
  ip          String?
  userAgent   String?
  at          DateTime           @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, at])
  @@map("document_access_logs")
}

model ShareLink {
  id           String    @id @default(uuid())
  documentId   String
  token        String    @unique // URL-safe random; carried in /share/:token
  passwordHash String?            // bcrypt — optional
  expiresAt    DateTime?
  maxAccesses  Int?
  accessCount  Int       @default(0)
  createdById  String?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("share_links")
}

// ─── FINANCE & ACCOUNTING (Section 6.5) ───────────────────────────────────────
//
// General-ledger backbone: hierarchical Chart of Accounts, fiscal periods
// with an OPEN→CLOSED→LOCKED state machine, and immutable double-entry
// JournalEntries posted only when debits == credits. AR and APr layer on top:
// every invoice/bill/payment posts a JournalEntry, with the posted entry id
// kept on the source record so audits can walk source → GL.

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum AccountSubtype {
  CASH
  BANK
  ACCOUNTS_RECEIVABLE
  ACCOUNTS_PAYABLE
  INVENTORY
  FIXED_ASSET
  CURRENT_LIABILITY
  LONG_TERM_LIABILITY
  TAX_PAYABLE
  TAX_RECOVERABLE
  SHARE_CAPITAL
  RETAINED_EARNINGS
  REVENUE
  COST_OF_GOODS_SOLD
  OPERATING_EXPENSE
  OTHER_INCOME
  OTHER_EXPENSE
}

model Account {
  id          String          @id @default(uuid())
  companyId   String
  code        String           // user-defined account code, e.g. "1000", "4100-01"
  name        String
  type        AccountType
  subtype     AccountSubtype?
  parentId    String?
  currency    String           @default("USD")
  isActive    Boolean          @default(true)
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // "Title" accounts are grouping nodes and cannot be posted to; only
  // "Active" leaf accounts accept journal lines. SAP calls this Title/Active.
  isTitle     Boolean          @default(false)
  // Control accounts are owned by a subledger (AR/AP) and only accept postings
  // that carry a bpId, keeping the subledger and GL reconciled.
  isControl   Boolean          @default(false)
  level       Int              @default(1)
  cashFlowLineItemId String?

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   Account?      @relation("AccountHierarchy", fields: [parentId], references: [id])
  children Account[]     @relation("AccountHierarchy")
  lines    JournalLine[]
  arInvoiceLines ARInvoiceLine[]
  apBillLines    APBillLine[]

  cashFlowLineItem     CashFlowLineItem?      @relation(fields: [cashFlowLineItemId], references: [id])
  accountDeterminations AccountDetermination[]
  postingTemplateLines PostingTemplateLine[]
  recurringPostingLines RecurringPostingLine[]
  budgetLines          BudgetLine[]
  houseBankAccounts    HouseBankAccount[]
  taxCodes             TaxCode[]
  assetsCost           FixedAsset[]           @relation("AssetCostAccount")
  assetsDepreciation   FixedAsset[]           @relation("AssetDepreciationAccount")
  assetsAccumulated    FixedAsset[]           @relation("AssetAccumulatedAccount")

  @@unique([companyId, code])
  @@index([companyId, type])
  @@index([parentId])
  @@map("accounts")
}

enum FiscalPeriodStatus {
  OPEN
  CLOSING
  CLOSED
  LOCKED
}

// Backs the "Posting Periods" window. `name` is the SAP "Period Code";
// sub-periods (months/quarters) are children of a year-level row via parentId,
// so a fiscal year and its 12 months live in one table.
model FiscalPeriod {
  id         String             @id @default(uuid())
  companyId  String
  name       String              // Period code: "2026", "2026-01", "FY2026-Q1"
  displayName String?            // SAP "Period Name" — free text
  parentId   String?             // year-level parent for a sub-period
  fiscalYear Int?
  subPeriodType SubPeriodType    @default(MONTHS)
  startDate  DateTime
  endDate    DateTime
  // "Active" and "Due Date" ranges are independent of the posting range in SAP.
  activeFrom DateTime?
  activeTo   DateTime?
  dueDateFrom DateTime?
  dueDateTo   DateTime?
  status     FiscalPeriodStatus @default(OPEN)
  // Per-area locks: a period can be closed for Sales but still open for General.
  salesStatus      FiscalPeriodStatus @default(OPEN)
  purchasingStatus FiscalPeriodStatus @default(OPEN)
  generalStatus    FiscalPeriodStatus @default(OPEN)
  inventoryStatus  FiscalPeriodStatus @default(OPEN)
  closedAt   DateTime?
  closedById String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   FiscalPeriod?  @relation("PeriodHierarchy", fields: [parentId], references: [id])
  children FiscalPeriod[] @relation("PeriodHierarchy")
  journals JournalEntry[]
  budgetLines BudgetLine[]

  @@unique([companyId, name])
  @@index([companyId, status])
  @@index([companyId, startDate, endDate])
  @@index([parentId])
  @@map("fiscal_periods")
}

enum SubPeriodType {
  YEAR
  MONTHS
  QUARTERS
  DAYS
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

model JournalEntry {
  id           String             @id @default(uuid())
  companyId    String
  periodId     String
  number       String              // unique per company; auto-generated
  date         DateTime
  description  String?
  reference    String?             // external (e.g. source invoice number)
  status       JournalEntryStatus  @default(DRAFT)
  postedAt     DateTime?
  postedById   String?
  reversalOfId String?   @unique   // points at the original being reversed; unique = each entry reversed at most once
  currency     String              @default("USD")
  totalDebit   Decimal             @db.Decimal(15, 2) @default(0)
  totalCredit  Decimal             @db.Decimal(15, 2) @default(0)
  source       String?             // "ar_invoice" | "ap_bill" | "ar_payment" | "ap_payment" | "manual"
  sourceId     String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  // ── Journal Entry window fields ──
  seriesId          String?         // NumberingSeries used to allocate `number`
  docDate           DateTime?       // "Doc. Date" — distinct from posting date
  dueDate           DateTime?
  transactionCodeId String?
  projectId         String?
  templateId        String?         // PostingTemplate this entry was built from
  indicator         String?
  ref1              String?
  ref2              String?
  ref3              String?
  isAdjustment      Boolean         @default(false)  // "Adj. Trans. (Period 13)"
  autoReverseDate   DateTime?       // "Reverse" checkbox → scheduled auto-reversal
  createdById       String?

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period     FiscalPeriod  @relation(fields: [periodId], references: [id])
  lines      JournalLine[]
  reversalOf JournalEntry? @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversal   JournalEntry? @relation("JournalReversal")

  series          NumberingSeries? @relation(fields: [seriesId], references: [id])
  transactionCode TransactionCode? @relation(fields: [transactionCodeId], references: [id])
  project         FinanceProject?  @relation(fields: [projectId], references: [id])
  template        PostingTemplate? @relation(fields: [templateId], references: [id])
  reconciliationLines InternalReconciliationLine[]

  arInvoice  ARInvoice?
  arPayment  ARPayment?
  apBill     APBill?
  apPayment  APPayment?

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([periodId])
  @@index([source, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id          String   @id @default(uuid())
  entryId     String
  accountId   String
  debit       Decimal  @db.Decimal(15, 2) @default(0)
  credit      Decimal  @db.Decimal(15, 2) @default(0)
  description String?
  ordering    Int      @default(0)

  // A GL line may be posted against a business partner control account
  // (subledger) instead of a plain G/L account — SAP's "G/L Acct/BP Code".
  bpId               String?
  // Cost accounting: up to five dimensions, each resolved to a cost center or
  // a distribution rule that fans the amount across cost centers.
  costCenterId       String?
  distributionRuleId String?
  projectId          String?
  taxCodeId          String?
  taxAmount          Decimal? @db.Decimal(15, 2)
  dueDate            DateTime?
  ref1               String?
  ref2               String?
  ref3               String?

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id])

  bp               BusinessPartner?  @relation(fields: [bpId], references: [id])
  costCenter       CostCenter?       @relation(fields: [costCenterId], references: [id])
  distributionRule DistributionRule? @relation(fields: [distributionRuleId], references: [id])
  project          FinanceProject?   @relation(fields: [projectId], references: [id])
  taxCode          TaxCode?          @relation(fields: [taxCodeId], references: [id])

  @@index([entryId])
  @@index([accountId])
  @@index([bpId])
  @@index([costCenterId])
  @@map("journal_lines")
}

// Daily exchange rates per company (base → target). The latest-on-or-before
// row for a (base, target, date) is used at posting time.
model ExchangeRate {
  id             String   @id @default(uuid())
  companyId      String
  baseCurrency   String   @default("USD")
  targetCurrency String
  rate           Decimal  @db.Decimal(15, 6)
  date           DateTime @db.Date
  source         String?  // "manual" | "ECB" | "openexchangerates" | …
  createdAt      DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, baseCurrency, targetCurrency, date])
  @@index([companyId, date])
  @@map("exchange_rates")
}

// ─── PAYMENT TERMS ────────────────────────────────────────────────────────────
model PaymentTerms {
  id              String   @id @default(uuid())
  companyId       String
  code            String
  name            String
  netDays         Int       // e.g. 30 for NET30
  discountDays    Int?      // for "2/10 Net 30" patterns
  discountPercent Decimal?  @db.Decimal(5, 2)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  businessPartners BusinessPartner[]
  arInvoices       ARInvoice[]
  apBills          APBill[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("payment_terms")
}

// Customers and Vendors are unified into the single BusinessPartner master
// (see the CRM section below) — cardType discriminates C / V / L, matching the
// "Business Partner Master Data" window. AR points at a CUSTOMER-or-LEAD
// partner, AP at a VENDOR partner; both sides share addresses, contacts and
// bank accounts instead of duplicating them per side.

// ─── ACCOUNTS RECEIVABLE ──────────────────────────────────────────────────────
enum ARInvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  WRITTEN_OFF
}

model ARInvoice {
  id             String          @id @default(uuid())
  companyId      String
  bpId           String          // BusinessPartner with cardType CUSTOMER or LEAD
  number         String          // unique per company; auto-generated
  issueDate      DateTime
  dueDate        DateTime?
  currency       String          @default("USD")
  subtotalMinor  Int             @default(0)
  taxMinor       Int             @default(0)
  totalMinor     Int             @default(0)
  paidMinor      Int             @default(0)
  status         ARInvoiceStatus @default(DRAFT)
  paymentTermsId String?
  notes          String?
  journalEntryId String?         @unique
  voidedAt       DateTime?
  voidedById     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bp           BusinessPartner @relation("BpArInvoices", fields: [bpId], references: [id])
  paymentTerms PaymentTerms?   @relation(fields: [paymentTermsId], references: [id])
  lines        ARInvoiceLine[]
  payments     ARPayment[]
  journalEntry JournalEntry?   @relation(fields: [journalEntryId], references: [id])

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([bpId])
  @@map("ar_invoices")
}

model ARInvoiceLine {
  id             String   @id @default(uuid())
  invoiceId      String
  description    String
  quantity       Decimal  @db.Decimal(15, 4) @default(1)
  unitPriceMinor Int
  lineTotalMinor Int
  taxPercent     Decimal? @db.Decimal(5, 2)
  taxMinor       Int      @default(0)
  accountId      String?

  invoice ARInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  account Account?  @relation(fields: [accountId], references: [id])

  @@index([invoiceId])
  @@map("ar_invoice_lines")
}

model ARPayment {
  id             String   @id @default(uuid())
  companyId      String
  invoiceId      String
  amountMinor    Int
  currency       String   @default("USD")
  method         String?  // "manual" | "wire" | "stripe" | …
  reference      String?
  receivedAt     DateTime
  journalEntryId String?  @unique
  createdAt      DateTime @default(now())

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice      ARInvoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@index([invoiceId])
  @@map("ar_payments")
}

// ─── ACCOUNTS PAYABLE ─────────────────────────────────────────────────────────
enum APBillStatus {
  DRAFT
  APPROVED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  ON_HOLD
}

model APBill {
  id             String       @id @default(uuid())
  companyId      String
  bpId           String        // BusinessPartner with cardType VENDOR
  number         String        // vendor's invoice number — not auto-generated
  issueDate      DateTime
  dueDate        DateTime?
  currency       String        @default("USD")
  subtotalMinor  Int           @default(0)
  taxMinor       Int           @default(0)
  totalMinor     Int           @default(0)
  paidMinor      Int           @default(0)
  status         APBillStatus  @default(DRAFT)
  paymentTermsId String?
  notes          String?
  journalEntryId String?       @unique
  voidedAt       DateTime?
  voidedById     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bp           BusinessPartner @relation("BpApBills", fields: [bpId], references: [id])
  paymentTerms PaymentTerms?   @relation(fields: [paymentTermsId], references: [id])
  lines        APBillLine[]
  payments     APPayment[]
  journalEntry JournalEntry?   @relation(fields: [journalEntryId], references: [id])

  @@unique([companyId, bpId, number])
  @@index([companyId, status])
  @@index([bpId])
  @@map("ap_bills")
}

model APBillLine {
  id             String   @id @default(uuid())
  billId         String
  description    String
  quantity       Decimal  @db.Decimal(15, 4) @default(1)
  unitPriceMinor Int
  lineTotalMinor Int
  taxPercent     Decimal? @db.Decimal(5, 2)
  taxMinor       Int      @default(0)
  accountId      String?

  bill    APBill   @relation(fields: [billId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id])

  @@index([billId])
  @@map("ap_bill_lines")
}

model APPayment {
  id             String   @id @default(uuid())
  companyId      String
  billId         String
  amountMinor    Int
  currency       String   @default("USD")
  method         String?
  reference      String?
  paidAt         DateTime
  journalEntryId String?  @unique
  createdAt      DateTime @default(now())

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bill         APBill        @relation(fields: [billId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@index([billId])
  @@map("ap_payments")
}

// ─── SHARED: ATTACHMENTS ──────────────────────────────────────────────────────
// Every SAP-style window carries an "Attachments" tab. Rather than a join table
// per document type, attachments are polymorphic on (entityType, entityId).
// `entityType` is the module-qualified name, e.g. "crm.activity",
// "financials.journal_entry".
model Attachment {
  id           String   @id @default(uuid())
  companyId    String
  entityType   String
  entityId     String
  fileName     String
  fileExtension String?
  fileSizeBytes Int      @default(0)
  targetPath   String?
  storageKey   String?  // key in the storage adapter (local FS or S3)
  freeText     String?
  uploadedById String?
  createdAt    DateTime @default(now())

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation(fields: [uploadedById], references: [id])

  @@index([companyId, entityType, entityId])
  @@map("attachments")
}

// ══════════════════════════════════════════════════════════════════════════════
// ADMINISTRATION (Section 6.13)
// ══════════════════════════════════════════════════════════════════════════════

// Backs "General Settings" and the other System Initialization windows. Rather
// than a column per checkbox (the window has ~200), settings are stored as
// (group, key) → JSON. `group` mirrors the window's tab: "general", "display",
// "bp", "budget", "services", "inventory", "purchasing", "path", "cash_flow",
// "font_background", "pricing".
model CompanySetting {
  id        String   @id @default(uuid())
  companyId String
  group     String
  key       String
  value     Json
  updatedAt DateTime @updatedAt
  updatedById String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, group, key])
  @@index([companyId, group])
  @@map("company_settings")
}

// Document Numbering. Each document type may have several series; exactly one
// per (company, documentType) is the default. `nextNumber` is allocated inside
// the same transaction as the document to keep numbering gap-free.
model NumberingSeries {
  id             String   @id @default(uuid())
  companyId      String
  documentType   String    // "journal_entry" | "ar_invoice" | "activity" | …
  name           String
  prefix         String?
  suffix         String?
  firstNumber    Int       @default(1)
  nextNumber     Int       @default(1)
  lastNumber     Int?
  digits         Int       @default(0)   // zero-pad width; 0 = no padding
  isDefault      Boolean   @default(false)
  isLocked       Boolean   @default(false)
  periodIndicator String?
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  remarks        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]

  @@unique([companyId, documentType, name])
  @@index([companyId, documentType])
  @@map("numbering_series")
}

// "Document Settings" — per-document-type behaviour flags. A row with
// documentType = null holds the General tab that applies to all documents.
model DocumentSetting {
  id           String   @id @default(uuid())
  companyId    String
  documentType String?
  settings     Json
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, documentType])
  @@map("document_settings")
}

model UserGroup {
  id          String   @id @default(uuid())
  companyId   String
  code        String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members UserGroupMember[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("user_groups")
}

model UserGroupMember {
  id      String @id @default(uuid())
  groupId String
  userId  String

  group UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("user_group_members")
}

model UserDefaultsGroup {
  id        String   @id @default(uuid())
  companyId String
  code      String
  name      String
  // Grouped per the window's tabs: general, documents, bp, path, services,
  // inventory, purchasing, print.
  defaults  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users   User[]

  @@unique([companyId, code])
  @@map("user_defaults_groups")
}

model PredefinedText {
  id        String   @id @default(uuid())
  companyId String
  code      String
  name      String?
  text      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@map("predefined_texts")
}

model Country {
  id           String   @id @default(uuid())
  companyId    String
  code         String    // ISO-3166 alpha-2
  name         String
  addressFormat String?  // template key used to render addresses
  isActive     Boolean  @default(true)

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  regions StateRegion[]

  @@unique([companyId, code])
  @@map("countries")
}

model StateRegion {
  id        String  @id @default(uuid())
  countryId String
  code      String
  name      String
  isActive  Boolean @default(true)

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([countryId, code])
  @@map("state_regions")
}

// ─── ALERTS MANAGEMENT ────────────────────────────────────────────────────────
enum AlertPriority {
  LOW
  NORMAL
  HIGH
}

enum AlertFrequency {
  ON_EVENT
  MINUTES
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
}

model AlertDefinition {
  id          String         @id @default(uuid())
  companyId   String
  name        String
  description String?
  priority    AlertPriority  @default(NORMAL)
  frequency   AlertFrequency @default(ON_EVENT)
  frequencyValue Int?        // e.g. every N minutes when frequency = MINUTES
  // Either an event key the platform emits, or a saved query evaluated on a
  // schedule. Exactly one is normally set.
  eventKey    String?
  savedQuery  String?
  isActive    Boolean        @default(true)
  lastRunAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscriptions AlertSubscription[]
  instances     AlertInstance[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("alert_definitions")
}

model AlertSubscription {
  id       String  @id @default(uuid())
  alertId  String
  userId   String
  internal Boolean @default(true)
  email    Boolean @default(false)
  sms      Boolean @default(false)

  alert AlertDefinition @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([alertId, userId])
  @@index([userId])
  @@map("alert_subscriptions")
}

model AlertInstance {
  id        String    @id @default(uuid())
  alertId   String
  userId    String
  subject   String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  alert AlertDefinition @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("alert_instances")
}

// ─── APPROVAL PROCESS ─────────────────────────────────────────────────────────
// This is the document-approval layer that sits in front of the generic
// WorkflowEngine: a template matches (documentType, originator, terms), and
// each of its ordered stages must be satisfied before the document posts.

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  GENERATED   // document was created after full approval
}

model ApprovalStage {
  id            String   @id @default(uuid())
  companyId     String
  name          String
  description   String?
  // How many of the assigned approvers must approve for the stage to pass.
  requiredApprovals Int  @default(1)
  remarks       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  approvers      ApprovalStageApprover[]
  templateStages ApprovalTemplateStage[]
  requestStages  ApprovalRequestStage[]

  @@unique([companyId, name])
  @@map("approval_stages")
}

model ApprovalStageApprover {
  id      String @id @default(uuid())
  stageId String
  userId  String

  stage ApprovalStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([stageId, userId])
  @@map("approval_stage_approvers")
}

model ApprovalTemplate {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  description String?
  isActive    Boolean  @default(true)
  // Document types this template guards, e.g. ["ar_invoice","purchase_order"].
  documentTypes String[]
  // Declarative trigger terms evaluated against the document:
  // { "always": false, "conditions": [{ "field": "totalMinor", "op": "gt", "value": 500000 }] }
  terms       Json     @default("{}")
  validFrom   DateTime?
  validTo     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  originators ApprovalTemplateOriginator[]
  stages      ApprovalTemplateStage[]
  requests    ApprovalRequest[]
  substitutes SubstituteAuthorizer[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("approval_templates")
}

model ApprovalTemplateOriginator {
  id         String @id @default(uuid())
  templateId String
  userId     String

  template ApprovalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([templateId, userId])
  @@map("approval_template_originators")
}

model ApprovalTemplateStage {
  id         String @id @default(uuid())
  templateId String
  stageId    String
  ordering   Int    @default(0)

  template ApprovalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stage    ApprovalStage    @relation(fields: [stageId], references: [id])

  @@unique([templateId, stageId])
  @@index([templateId, ordering])
  @@map("approval_template_stages")
}

model ApprovalRequest {
  id           String                @id @default(uuid())
  companyId    String
  templateId   String
  documentType String
  documentId   String?               // null while the draft is still unsaved
  documentNumber String?
  originatorId String
  status       ApprovalRequestStatus @default(PENDING)
  currentStageOrder Int              @default(0)
  remarks      String?
  // Snapshot of the document at submission, so approvers see what they approved
  // even if the draft is edited afterwards.
  documentSnapshot Json?
  resolvedAt   DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template   ApprovalTemplate      @relation(fields: [templateId], references: [id])
  originator User                  @relation("ApprovalOriginator", fields: [originatorId], references: [id])
  stages     ApprovalRequestStage[]
  decisions  DocumentApprovalDecision[]

  @@index([companyId, status])
  @@index([documentType, documentId])
  @@map("approval_requests")
}

model ApprovalRequestStage {
  id        String                @id @default(uuid())
  requestId String
  stageId   String
  ordering  Int                   @default(0)
  status    ApprovalRequestStatus @default(PENDING)
  resolvedAt DateTime?

  request   ApprovalRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stage     ApprovalStage      @relation(fields: [stageId], references: [id])
  decisions DocumentApprovalDecision[]

  @@unique([requestId, stageId])
  @@index([requestId, ordering])
  @@map("approval_request_stages")
}

// Reuses the workflow engine's ApprovalDecision enum (APPROVED | REJECTED);
// the model is prefixed to avoid colliding with that enum's name.
model DocumentApprovalDecision {
  id             String           @id @default(uuid())
  requestId      String
  requestStageId String
  approverId     String
  decision       ApprovalDecision
  remarks        String?
  decidedAt      DateTime         @default(now())
  // Set when the decision was cast by a stand-in rather than the named approver.
  onBehalfOfId   String?

  request      ApprovalRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestStage ApprovalRequestStage @relation(fields: [requestStageId], references: [id], onDelete: Cascade)
  approver     User                 @relation(fields: [approverId], references: [id])

  @@unique([requestStageId, approverId])
  @@index([requestId])
  @@map("document_approval_decisions")
}

model SubstituteAuthorizer {
  id             String   @id @default(uuid())
  companyId      String
  templateId     String?  // null = applies to every template
  originalUserId String
  substituteUserId String
  validFrom      DateTime
  validTo        DateTime
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template   ApprovalTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  original   User              @relation("SubstituteOriginal", fields: [originalUserId], references: [id])
  substitute User              @relation("SubstituteStandIn", fields: [substituteUserId], references: [id])

  @@index([companyId, isActive])
  @@index([originalUserId])
  @@map("substitute_authorizers")
}

// ══════════════════════════════════════════════════════════════════════════════
// CRM & BUSINESS PARTNERS (Section 6.14)
// ══════════════════════════════════════════════════════════════════════════════

enum BpCardType {
  CUSTOMER
  VENDOR
  LEAD
}

model BusinessPartnerGroup {
  id        String     @id @default(uuid())
  companyId String
  type      BpCardType
  code      String
  name      String
  isActive  Boolean    @default(true)

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partners BusinessPartner[]

  @@unique([companyId, type, code])
  @@map("bp_groups")
}

model BusinessPartner {
  id        String     @id @default(uuid())
  companyId String
  cardCode  String      // "C10001" / "V20001" — unique per company
  cardName  String
  cardType  BpCardType  @default(CUSTOMER)
  foreignName String?
  groupId   String?
  currency  String      @default("USD")
  federalTaxId String?
  // ── General tab ──
  phone1    String?
  phone2    String?
  mobile    String?
  fax       String?
  email     String?
  website   String?
  shippingType String?
  // ── Sales ownership ──
  territoryId      String?
  salesEmployeeId  String?
  // ── Payment terms tab ──
  paymentTermsId   String?
  paymentMethodId  String?
  dunningTermId    String?
  creditLimit      Decimal? @db.Decimal(15, 2)
  commitmentLimit  Decimal? @db.Decimal(15, 2)
  discountPercent  Decimal? @db.Decimal(5, 2)
  interestOnArrears Decimal? @db.Decimal(5, 2)
  priceListId      String?
  // ── Accounting tab: control accounts overriding the company defaults ──
  controlAccountId String?
  downPaymentAccountId String?
  // ── Running balances, maintained by AR/AP posting ──
  accountBalance      Decimal @db.Decimal(15, 2) @default(0)
  ordersBalance       Decimal @db.Decimal(15, 2) @default(0)
  deliveriesBalance   Decimal @db.Decimal(15, 2) @default(0)
  opportunitiesAmount Decimal @db.Decimal(15, 2) @default(0)
  // ── Properties tab: 64 named boolean slots in SAP; stored as a JSON set ──
  properties Json?
  industry   String?
  businessType String?
  priority   String?
  blockDunning Boolean @default(false)
  isActive   Boolean  @default(true)
  validFrom  DateTime?
  validTo    DateTime?
  remarks    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company        Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  group          BusinessPartnerGroup? @relation(fields: [groupId], references: [id])
  territory      Territory?            @relation(fields: [territoryId], references: [id])
  salesEmployee  SalesEmployee?        @relation(fields: [salesEmployeeId], references: [id])
  paymentTerms   PaymentTerms?         @relation(fields: [paymentTermsId], references: [id])
  paymentMethod  PaymentMethod?        @relation(fields: [paymentMethodId], references: [id])
  dunningTerm    DunningTerm?          @relation(fields: [dunningTermId], references: [id])

  contacts     BpContactPerson[]
  addresses    BpAddress[]
  bankAccounts BpBankAccount[]
  activities   Activity[]
  opportunities Opportunity[]
  journalLines JournalLine[]
  campaignTargets CampaignTarget[]
  relationsFrom BpRelationship[] @relation("RelationFrom")
  relationsTo   BpRelationship[] @relation("RelationTo")
  arInvoices   ARInvoice[]       @relation("BpArInvoices")
  apBills      APBill[]          @relation("BpApBills")
  internalReconciliations InternalReconciliation[]

  @@unique([companyId, cardCode])
  @@index([companyId, cardType])
  @@index([companyId, cardName])
  @@map("business_partners")
}

model BpContactPerson {
  id         String   @id @default(uuid())
  bpId       String
  name       String
  position   String?
  title      String?
  address    String?
  phone1     String?
  phone2     String?
  mobile     String?
  fax        String?
  email      String?
  pager      String?
  profession String?
  birthDate  DateTime?
  gender     String?
  remarks1   String?
  remarks2   String?
  isDefault  Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  bp         BusinessPartner @relation(fields: [bpId], references: [id], onDelete: Cascade)
  activities Activity[]
  opportunities Opportunity[]
  campaignTargets CampaignTarget[]

  @@index([bpId])
  @@map("bp_contact_persons")
}

enum BpAddressType {
  BILL_TO
  SHIP_TO
}

model BpAddress {
  id          String        @id @default(uuid())
  bpId        String
  addressName String
  addressType BpAddressType @default(BILL_TO)
  street      String?
  streetNo    String?
  block       String?
  building    String?
  city        String?
  zipCode     String?
  county      String?
  state       String?
  country     String?
  gln         String?
  taxCode     String?
  isDefault   Boolean       @default(false)

  bp BusinessPartner @relation(fields: [bpId], references: [id], onDelete: Cascade)

  @@unique([bpId, addressType, addressName])
  @@index([bpId])
  @@map("bp_addresses")
}

model BpBankAccount {
  id          String  @id @default(uuid())
  bpId        String
  bankCode    String?
  bankName    String?
  branch      String?
  accountNo   String?
  accountName String?
  iban        String?
  swift       String?
  controlKey  String?
  isDefault   Boolean @default(false)

  bp BusinessPartner @relation(fields: [bpId], references: [id], onDelete: Cascade)

  @@index([bpId])
  @@map("bp_bank_accounts")
}

model BpRelationshipType {
  id        String @id @default(uuid())
  companyId String
  code      String
  name      String

  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  relationships BpRelationship[]

  @@unique([companyId, code])
  @@map("bp_relationship_types")
}

model BpRelationship {
  id       String  @id @default(uuid())
  fromBpId String
  toBpId   String
  typeId   String
  remarks  String?

  fromBp BusinessPartner    @relation("RelationFrom", fields: [fromBpId], references: [id], onDelete: Cascade)
  toBp   BusinessPartner    @relation("RelationTo", fields: [toBpId], references: [id], onDelete: Cascade)
  type   BpRelationshipType @relation(fields: [typeId], references: [id])

  @@unique([fromBpId, toBpId, typeId])
  @@map("bp_relationships")
}

// ─── SALES ORGANISATION ───────────────────────────────────────────────────────
model Territory {
  id        String   @id @default(uuid())
  companyId String
  name      String
  parentId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   Territory?  @relation("TerritoryHierarchy", fields: [parentId], references: [id])
  children Territory[] @relation("TerritoryHierarchy")

  partners       BusinessPartner[]
  salesEmployees SalesEmployee[]
  opportunities  Opportunity[]

  @@unique([companyId, name])
  @@index([parentId])
  @@map("territories")
}

model CommissionGroup {
  id               String   @id @default(uuid())
  companyId        String
  code             String
  name             String
  commissionPercent Decimal @db.Decimal(5, 2) @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesEmployees SalesEmployee[]

  @@unique([companyId, code])
  @@map("commission_groups")
}

// "Sales Employees / Buyers". Optionally linked to a User (so the person can
// log in) and/or an Employee (HR record) — both are optional because SAP allows
// sales-employee rows for people who are neither.
model SalesEmployee {
  id                String   @id @default(uuid())
  companyId         String
  code              String
  name              String
  jobTitle          String?
  commissionGroupId String?
  commissionPercent Decimal? @db.Decimal(5, 2)
  territoryId       String?
  telephone         String?
  mobile            String?
  fax               String?
  email             String?
  remarks           String?
  isActive          Boolean  @default(true)
  userId            String?  @unique
  employeeId        String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  commissionGroup CommissionGroup? @relation(fields: [commissionGroupId], references: [id])
  territory       Territory?       @relation(fields: [territoryId], references: [id])
  user            User?            @relation(fields: [userId], references: [id])
  employee        Employee?        @relation(fields: [employeeId], references: [id])

  partners      BusinessPartner[]
  opportunities Opportunity[]
  stageEntries  OpportunityStageEntry[]
  campaigns     Campaign[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("sales_employees")
}

// ─── ACTIVITIES ───────────────────────────────────────────────────────────────
enum ActivityKind {
  MEETING
  PHONE_CALL
  TASK
  NOTE
  CAMPAIGN
  OTHER
}

enum ActivityStatus {
  OPEN
  IN_PROGRESS
  CLOSED
  CANCELLED
}

enum ActivityPriority {
  LOW
  NORMAL
  HIGH
}

model Activity {
  id              String           @id @default(uuid())
  companyId       String
  docNumber       Int?             // sequential per company, from NumberingSeries
  kind            ActivityKind     @default(TASK)
  subject         String
  activityType    String?          // free-form sub-type ("General", "Support", …)
  bpId            String?
  contactPersonId String?
  priority        ActivityPriority @default(NORMAL)
  status          ActivityStatus   @default(OPEN)
  startDate       DateTime
  startTime       String?          // "HH:mm" — the window has separate time fields
  endDate         DateTime?
  endTime         String?
  durationMinutes Int?
  location        String?
  // ── Reminder ──
  reminderEnabled Boolean          @default(false)
  reminderMinutesBefore Int?
  reminderSentAt  DateTime?
  // ── Recurrence: { freq, interval, until, byDay } ──
  recurrence      Json?
  parentActivityId String?
  // ── Linked document (the "Linked Document" tab) ──
  linkedDocType   String?
  linkedDocId     String?
  linkedDocNumber String?
  // ── Content / Other details tabs ──
  content         String?
  remarks         String?
  ownerId         String?
  assignedToUserId String?
  closedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bp            BusinessPartner? @relation(fields: [bpId], references: [id])
  contactPerson BpContactPerson? @relation(fields: [contactPersonId], references: [id])
  owner         User?            @relation("ActivityOwner", fields: [ownerId], references: [id])
  assignedTo    User?            @relation("ActivityAssignee", fields: [assignedToUserId], references: [id])
  parent        Activity?        @relation("ActivityRecurrence", fields: [parentActivityId], references: [id])
  occurrences   Activity[]       @relation("ActivityRecurrence")
  opportunityStages OpportunityStageEntry[]

  @@unique([companyId, docNumber])
  @@index([companyId, status])
  @@index([bpId])
  @@index([assignedToUserId, status])
  @@index([companyId, startDate])
  @@map("activities")
}

// ─── OPPORTUNITIES ────────────────────────────────────────────────────────────
enum OpportunityStatus {
  OPEN
  WON
  LOST
}

// Setup → Opportunities → Opportunity Stages
model OpportunityStageDef {
  id             String   @id @default(uuid())
  companyId      String
  stageNo        Int
  name           String
  closingPercent Decimal  @db.Decimal(5, 2) @default(0)
  isActive       Boolean  @default(true)

  company Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entries OpportunityStageEntry[]
  opportunities Opportunity[]

  @@unique([companyId, stageNo])
  @@map("opportunity_stage_defs")
}

model Competitor {
  id          String  @id @default(uuid())
  companyId   String
  code        String
  name        String
  threatLevel String?
  remarks     String?
  isActive    Boolean @default(true)

  company       Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunities OpportunityCompetitor[]

  @@unique([companyId, code])
  @@map("competitors")
}

// Setup → Opportunities → Partners. A third party involved in a deal
// (reseller, integrator) — distinct from a BusinessPartner record.
model CrmPartner {
  id        String  @id @default(uuid())
  companyId String
  code      String
  name      String
  type      String?
  isActive  Boolean @default(true)

  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunities OpportunityPartner[]

  @@unique([companyId, code])
  @@map("crm_partners")
}

model InformationSource {
  id        String  @id @default(uuid())
  companyId String
  code      String
  name      String
  isActive  Boolean @default(true)

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@unique([companyId, code])
  @@map("information_sources")
}

model Opportunity {
  id              String            @id @default(uuid())
  companyId       String
  docNumber       Int?
  name            String
  bpId            String
  contactPersonId String?
  salesEmployeeId String?
  territoryId     String?
  currentStageId  String?
  status          OpportunityStatus @default(OPEN)
  level           Int               @default(1)
  startDate       DateTime
  closingDate     DateTime?
  predictedClosingDate DateTime?
  // ── Potential tab ──
  currency        String            @default("USD")
  potentialAmount Decimal           @db.Decimal(15, 2) @default(0)
  weightedAmount  Decimal           @db.Decimal(15, 2) @default(0)
  closePercent    Decimal           @db.Decimal(5, 2)  @default(0)
  grossProfit     Decimal?          @db.Decimal(15, 2)
  grossProfitPercent Decimal?       @db.Decimal(5, 2)
  // ── General tab ──
  informationSourceId String?
  industry        String?
  interestField   String?
  interestLevel   String?
  reasonId        String?
  // ── Closing ──
  wonLostReason   String?
  remarks         String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bp            BusinessPartner      @relation(fields: [bpId], references: [id])
  contactPerson BpContactPerson?     @relation(fields: [contactPersonId], references: [id])
  salesEmployee SalesEmployee?       @relation(fields: [salesEmployeeId], references: [id])
  territory     Territory?           @relation(fields: [territoryId], references: [id])
  currentStage  OpportunityStageDef? @relation(fields: [currentStageId], references: [id])
  informationSource InformationSource? @relation(fields: [informationSourceId], references: [id])

  stages      OpportunityStageEntry[]
  competitors OpportunityCompetitor[]
  partners    OpportunityPartner[]

  @@unique([companyId, docNumber])
  @@index([companyId, status])
  @@index([bpId])
  @@index([salesEmployeeId])
  @@map("opportunities")
}

// One row per stage the opportunity has passed through — the "Stages" tab grid.
model OpportunityStageEntry {
  id              String   @id @default(uuid())
  opportunityId   String
  stageDefId      String
  ordering        Int      @default(0)
  startDate       DateTime?
  closingDate     DateTime?
  closePercent    Decimal  @db.Decimal(5, 2) @default(0)
  potentialAmount Decimal  @db.Decimal(15, 2) @default(0)
  weightedAmount  Decimal  @db.Decimal(15, 2) @default(0)
  salesEmployeeId String?
  activityId      String?
  docType         String?
  docNumber       String?
  remarks         String?
  completedAt     DateTime?

  opportunity   Opportunity         @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  stageDef      OpportunityStageDef @relation(fields: [stageDefId], references: [id])
  salesEmployee SalesEmployee?      @relation(fields: [salesEmployeeId], references: [id])
  activity      Activity?           @relation(fields: [activityId], references: [id])

  @@index([opportunityId, ordering])
  @@map("opportunity_stage_entries")
}

model OpportunityCompetitor {
  id            String  @id @default(uuid())
  opportunityId String
  competitorId  String
  threatLevel   String?
  strengths     String?
  weaknesses    String?
  remarks       String?

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  competitor  Competitor  @relation(fields: [competitorId], references: [id])

  @@unique([opportunityId, competitorId])
  @@map("opportunity_competitors")
}

model OpportunityPartner {
  id            String  @id @default(uuid())
  opportunityId String
  partnerId     String
  role          String?
  remarks       String?

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  partner     CrmPartner  @relation(fields: [partnerId], references: [id])

  @@unique([opportunityId, partnerId])
  @@map("opportunity_partners")
}

// ─── CAMPAIGNS ────────────────────────────────────────────────────────────────
enum CampaignStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

model Campaign {
  id              String         @id @default(uuid())
  companyId       String
  campaignNumber  Int?
  name            String
  type            String?
  status          CampaignStatus @default(PLANNED)
  startDate       DateTime?
  endDate         DateTime?
  salesEmployeeId String?
  targetGroup     String?
  budgetAmount    Decimal?       @db.Decimal(15, 2)
  revenueAmount   Decimal?       @db.Decimal(15, 2)
  remarks         String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesEmployee SalesEmployee?   @relation(fields: [salesEmployeeId], references: [id])
  targets       CampaignTarget[]

  @@unique([companyId, campaignNumber])
  @@index([companyId, status])
  @@map("campaigns")
}

model CampaignTarget {
  id              String  @id @default(uuid())
  campaignId      String
  bpId            String?
  contactPersonId String?
  response        String?
  remarks         String?

  campaign      Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  bp            BusinessPartner? @relation(fields: [bpId], references: [id])
  contactPerson BpContactPerson? @relation(fields: [contactPersonId], references: [id])

  @@index([campaignId])
  @@map("campaign_targets")
}

// ══════════════════════════════════════════════════════════════════════════════
// FINANCIALS — SETUP, COST ACCOUNTING, BUDGETS, ASSETS (Section 6.15)
// ══════════════════════════════════════════════════════════════════════════════

model Currency {
  id            String  @id @default(uuid())
  companyId     String
  code          String   // ISO-4217
  name          String
  intlDescription String?
  hundredthName String?  // "Cents", "Paisa"
  decimals      Int     @default(2)
  rounding      String? // "standard" | "up" | "down"
  isActive      Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@map("currencies")
}

// G/L Account Determination — the mapping table that tells posting routines
// which account to hit for a named purpose, per functional area.
enum AccountDeterminationArea {
  SALES
  PURCHASING
  GENERAL
  INVENTORY
}

model AccountDetermination {
  id        String                   @id @default(uuid())
  companyId String
  area      AccountDeterminationArea
  key       String                    // "domestic_ar", "tax_payable", "rounding", …
  accountId String
  updatedAt DateTime                 @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id])

  @@unique([companyId, area, key])
  @@map("account_determinations")
}

model FinanceProject {
  id        String   @id @default(uuid())
  companyId String
  code      String
  name      String
  validFrom DateTime?
  validTo   DateTime?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]
  journalLines   JournalLine[]

  @@unique([companyId, code])
  @@map("finance_projects")
}

model TransactionCode {
  id          String  @id @default(uuid())
  companyId   String
  code        String
  description String
  isActive    Boolean @default(true)

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]

  @@unique([companyId, code])
  @@map("transaction_codes")
}

enum TaxCodeType {
  SALES
  PURCHASE
  WITHHOLDING
}

model TaxCode {
  id        String      @id @default(uuid())
  companyId String
  code      String
  name      String
  type      TaxCodeType @default(SALES)
  rate      Decimal     @db.Decimal(7, 4) @default(0)
  accountId String?
  validFrom DateTime?
  validTo   DateTime?
  isActive  Boolean     @default(true)

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id])
  lines   JournalLine[]

  @@unique([companyId, code])
  @@map("tax_codes")
}

model CashFlowLineItem {
  id        String  @id @default(uuid())
  companyId String
  code      String
  name      String
  parentId  String?
  section   String?  // "operating" | "investing" | "financing"
  isActive  Boolean @default(true)

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   CashFlowLineItem?  @relation("CashFlowHierarchy", fields: [parentId], references: [id])
  children CashFlowLineItem[] @relation("CashFlowHierarchy")
  accounts Account[]

  @@unique([companyId, code])
  @@map("cash_flow_line_items")
}

// ─── POSTING TEMPLATES & RECURRING POSTINGS ───────────────────────────────────
model PostingTemplate {
  id          String   @id @default(uuid())
  companyId   String
  code        String
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   PostingTemplateLine[]
  entries JournalEntry[]

  @@unique([companyId, code])
  @@map("posting_templates")
}

// Percentage templates spread a single amount across accounts; the percentages
// on the debit side and on the credit side must each total 100.
model PostingTemplateLine {
  id          String   @id @default(uuid())
  templateId  String
  accountId   String
  description String?
  percentage  Decimal  @db.Decimal(7, 4) @default(0)
  side        String    // "debit" | "credit"
  ordering    Int      @default(0)

  template PostingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  account  Account         @relation(fields: [accountId], references: [id])

  @@index([templateId, ordering])
  @@map("posting_template_lines")
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMIANNUALLY
  ANNUALLY
  ONE_TIME
}

model RecurringPosting {
  id             String              @id @default(uuid())
  companyId      String
  code           String
  description    String
  frequency      RecurrenceFrequency @default(MONTHLY)
  nextExecution  DateTime
  validUntil     DateTime?
  executionCount Int                 @default(0)
  maxExecutions  Int?
  currency       String              @default("USD")
  isActive       Boolean             @default(true)
  lastExecutedAt DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  company Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   RecurringPostingLine[]

  @@unique([companyId, code])
  @@index([companyId, isActive, nextExecution])
  @@map("recurring_postings")
}

model RecurringPostingLine {
  id          String   @id @default(uuid())
  recurringId String
  accountId   String
  debit       Decimal  @db.Decimal(15, 2) @default(0)
  credit      Decimal  @db.Decimal(15, 2) @default(0)
  description String?
  ordering    Int      @default(0)

  recurring RecurringPosting @relation(fields: [recurringId], references: [id], onDelete: Cascade)
  account   Account          @relation(fields: [accountId], references: [id])

  @@index([recurringId])
  @@map("recurring_posting_lines")
}

// ─── COST ACCOUNTING ──────────────────────────────────────────────────────────
model Dimension {
  id          String  @id @default(uuid())
  companyId   String
  dimensionNo Int      // 1..5
  name        String
  description String?
  isActive    Boolean @default(true)

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  costCenters       CostCenter[]
  distributionRules DistributionRule[]

  @@unique([companyId, dimensionNo])
  @@map("dimensions")
}

model CostCenter {
  id          String   @id @default(uuid())
  companyId   String
  dimensionId String
  code        String
  name        String
  parentId    String?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dimension Dimension    @relation(fields: [dimensionId], references: [id])
  parent    CostCenter?  @relation("CostCenterHierarchy", fields: [parentId], references: [id])
  children  CostCenter[] @relation("CostCenterHierarchy")

  journalLines      JournalLine[]
  distributionLines DistributionRuleLine[]
  budgetLines       BudgetLine[]

  @@unique([companyId, dimensionId, code])
  @@index([companyId])
  @@map("cost_centers")
}

// A distribution rule fans one posted amount across several cost centers by
// ratio. `totalRatio` is the denominator: a line with ratio 3 out of a total of
// 10 receives 30% of the amount.
model DistributionRule {
  id          String   @id @default(uuid())
  companyId   String
  dimensionId String
  code        String
  name        String
  totalRatio  Decimal  @db.Decimal(15, 4) @default(0)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dimension Dimension              @relation(fields: [dimensionId], references: [id])
  lines     DistributionRuleLine[]
  journalLines JournalLine[]

  @@unique([companyId, dimensionId, code])
  @@map("distribution_rules")
}

model DistributionRuleLine {
  id           String  @id @default(uuid())
  ruleId       String
  costCenterId String
  ratio        Decimal @db.Decimal(15, 4) @default(0)

  rule       DistributionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  costCenter CostCenter       @relation(fields: [costCenterId], references: [id])

  @@unique([ruleId, costCenterId])
  @@map("distribution_rule_lines")
}

// ─── BUDGETS ──────────────────────────────────────────────────────────────────
model BudgetScenario {
  id                String   @id @default(uuid())
  companyId         String
  code              String
  name              String
  fiscalYear        Int
  // A scenario can be derived from another by a percentage ("2027 = 2026 +10%").
  basedOnScenarioId String?
  initialRatio      Decimal  @db.Decimal(7, 4) @default(100)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  basedOn   BudgetScenario?  @relation("ScenarioDerivation", fields: [basedOnScenarioId], references: [id])
  derived   BudgetScenario[] @relation("ScenarioDerivation")
  lines     BudgetLine[]

  @@unique([companyId, code])
  @@map("budget_scenarios")
}

// Spreads an annual budget figure over the periods of the year.
// `monthlyRatios` is a 12-element array summing to 100.
model BudgetDistributionMethod {
  id            String   @id @default(uuid())
  companyId     String
  code          String
  name          String
  monthlyRatios Json     @default("[]")
  isActive      Boolean  @default(true)

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   BudgetLine[]

  @@unique([companyId, code])
  @@map("budget_distribution_methods")
}

model BudgetLine {
  id                   String   @id @default(uuid())
  companyId            String
  scenarioId           String
  accountId            String
  costCenterId         String?
  periodId             String?
  distributionMethodId String?
  annualDebit          Decimal  @db.Decimal(15, 2) @default(0)
  annualCredit         Decimal  @db.Decimal(15, 2) @default(0)
  // Per-period breakdown after distribution: [{ period: "2026-01", debit, credit }]
  breakdown            Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company            Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  scenario           BudgetScenario            @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  account            Account                   @relation(fields: [accountId], references: [id])
  costCenter         CostCenter?               @relation(fields: [costCenterId], references: [id])
  period             FiscalPeriod?             @relation(fields: [periodId], references: [id])
  distributionMethod BudgetDistributionMethod? @relation(fields: [distributionMethodId], references: [id])

  @@unique([scenarioId, accountId, costCenterId, periodId])
  @@index([companyId, scenarioId])
  @@map("budget_lines")
}

// ─── BANKING SETUP ────────────────────────────────────────────────────────────
model Bank {
  id        String  @id @default(uuid())
  companyId String
  code      String
  name      String
  swift     String?
  country   String?
  isActive  Boolean @default(true)

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accounts HouseBankAccount[]

  @@unique([companyId, code])
  @@map("banks")
}

model HouseBankAccount {
  id           String  @id @default(uuid())
  companyId    String
  bankId       String
  accountNo    String
  accountName  String?
  branch       String?
  iban         String?
  currency     String  @default("USD")
  glAccountId  String?
  isDefault    Boolean @default(false)
  isActive     Boolean @default(true)

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bank      Bank           @relation(fields: [bankId], references: [id])
  glAccount Account?       @relation(fields: [glAccountId], references: [id])
  paymentMethods PaymentMethod[]

  @@unique([companyId, bankId, accountNo])
  @@map("house_bank_accounts")
}

enum PaymentDirection {
  INCOMING
  OUTGOING
}

model PaymentMethod {
  id                 String           @id @default(uuid())
  companyId          String
  code               String
  description        String
  direction          PaymentDirection @default(INCOMING)
  paymentMeans       String?          // "check" | "bank_transfer" | "cash" | "credit_card"
  houseBankAccountId String?
  isActive           Boolean          @default(true)

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  houseBankAccount HouseBankAccount? @relation(fields: [houseBankAccountId], references: [id])
  partners         BusinessPartner[]

  @@unique([companyId, code])
  @@map("payment_methods")
}

model DunningTerm {
  id        String   @id @default(uuid())
  companyId String
  code      String
  name      String
  // [{ level: 1, daysAfterDue: 14, feeAmount: 0, interestPercent: 0, letterTemplate: "…" }]
  levels    Json     @default("[]")
  isActive  Boolean  @default(true)

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partners BusinessPartner[]

  @@unique([companyId, code])
  @@map("dunning_terms")
}

// ─── INTERNAL RECONCILIATION ──────────────────────────────────────────────────
// Matches debits against credits on a BP or G/L account so open items can be
// cleared. Reversible: `cancelledAt` unclears the matched rows.
model InternalReconciliation {
  id            String   @id @default(uuid())
  companyId     String
  bpId          String?
  accountId     String?
  reconciledAt  DateTime
  totalAmount   Decimal  @db.Decimal(15, 2) @default(0)
  currency      String   @default("USD")
  reconciledById String?
  cancelledAt   DateTime?
  remarks       String?
  createdAt     DateTime @default(now())

  company Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bp      BusinessPartner?             @relation(fields: [bpId], references: [id])
  lines   InternalReconciliationLine[]

  @@index([companyId, bpId])
  @@map("internal_reconciliations")
}

model InternalReconciliationLine {
  id               String  @id @default(uuid())
  reconciliationId String
  journalEntryId   String
  amount           Decimal @db.Decimal(15, 2)

  reconciliation InternalReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  journalEntry   JournalEntry           @relation(fields: [journalEntryId], references: [id])

  @@index([reconciliationId])
  @@map("internal_reconciliation_lines")
}

// ─── FIXED ASSETS ─────────────────────────────────────────────────────────────
enum DepreciationMethod {
  STRAIGHT_LINE
  DECLINING_BALANCE
  SUM_OF_YEARS
  IMMEDIATE
  NONE
}

enum FixedAssetStatus {
  NEW
  CAPITALIZED
  RETIRED
  SOLD
}

model FixedAsset {
  id             String             @id @default(uuid())
  companyId      String
  code           String
  name           String
  assetClass     String?
  status         FixedAssetStatus   @default(NEW)
  capitalizedAt  DateTime?
  retiredAt      DateTime?
  usefulLifeMonths Int              @default(60)
  depreciationMethod DepreciationMethod @default(STRAIGHT_LINE)
  acquisitionCost   Decimal         @db.Decimal(15, 2) @default(0)
  salvageValue      Decimal         @db.Decimal(15, 2) @default(0)
  accumulatedDepreciation Decimal   @db.Decimal(15, 2) @default(0)
  netBookValue      Decimal         @db.Decimal(15, 2) @default(0)
  currency          String          @default("USD")
  costAccountId          String?
  depreciationAccountId  String?
  accumulatedAccountId   String?
  costCenterId      String?
  serialNumber      String?
  location          String?
  remarks           String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  costAccount         Account? @relation("AssetCostAccount", fields: [costAccountId], references: [id])
  depreciationAccount Account? @relation("AssetDepreciationAccount", fields: [depreciationAccountId], references: [id])
  accumulatedAccount  Account? @relation("AssetAccumulatedAccount", fields: [accumulatedAccountId], references: [id])
  transactions        FixedAssetTransaction[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@map("fixed_assets")
}

enum AssetTransactionType {
  CAPITALIZATION
  CAPITALIZATION_CREDIT_MEMO
  DEPRECIATION
  MANUAL_DEPRECIATION
  REVALUATION
  TRANSFER
  RETIREMENT
}

model FixedAssetTransaction {
  id             String               @id @default(uuid())
  assetId        String
  type           AssetTransactionType
  postingDate    DateTime
  amount         Decimal              @db.Decimal(15, 2)
  journalEntryId String?
  remarks        String?
  createdAt      DateTime             @default(now())

  asset FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, postingDate])
  @@map("fixed_asset_transactions")
}
