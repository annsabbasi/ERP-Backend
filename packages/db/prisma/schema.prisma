  @@index([tenantId, headMembershipId])
  @@map("departments")
  @@schema("app")
}

model Team {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  name             String
  /// Same-tenant reference: composite FK written in SQL (migration tenant_safe_references), not a Prisma relation, because Prisma cannot model an optional reference whose key includes the required tenant_id.
  leadMembershipId String?   @map("lead_membership_id") @db.Uuid
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy        String?   @map("created_by") @db.Uuid
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy        String?   @map("updated_by") @db.Uuid
  version          Int       @default(1)

  members TeamMember[]

  @@unique([tenantId, id])
  @@index([tenantId, leadMembershipId])
  @@map("teams")
  @@schema("app")
}

model TeamMember {
  tenantId     String   @map("tenant_id") @db.Uuid
