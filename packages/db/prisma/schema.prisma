// Data model of the new build (Part 11 §11.1–11.4). The connection URL comes from the
// environment (see prisma.config.ts). Schema public is never used.
//
// Conventions (§11.1): tables plural snake_case, ids UUID v7 made by the application,
// tenant_id on every app.* table (Row-Level Security, §10.5), status columns as text with a
// CHECK constraint, money as numeric(19,4). CHECK constraints, roles, grants, RLS policies,
// triggers and functions live in the migration SQL; Prisma does not model them.
//
// Prisma cannot model a composite foreign key whose columns differ in nullability, so only
// required references are composite (tenant_id, x_id) → (tenant_id, id). Optional references
// point at the id alone; RLS hides other tenants' rows and the repository layer checks the
// tenant on write (§10.5.2).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["platform", "identity", "app"]
}

// ─────────────────────────────── platform (control plane, §11.2) ───────────────────────────────

model Tenant {
  id                  String    @id @default(uuid(7)) @db.Uuid
  code                String    @unique
  slug                String    @unique
  displayName         String    @map("display_name")
  legalName           String    @map("legal_name")
  country             String    @db.Char(2)
  baseCurrency        String    @map("base_currency") @db.Char(3)
  timezone            String
  locale              String    @default("en")
  industryKey         String    @map("industry_key")
  templateKey         String?   @map("template_key")
  templateVersion     String?   @map("template_version")
  status              String
  isolationModel      String    @default("pooled") @map("isolation_model")
  region              String
  databaseRef         String?   @map("database_ref")
  ownerUserId         String?   @map("owner_user_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  activatedAt         DateTime? @map("activated_at") @db.Timestamptz(6)
  suspendedAt         DateTime? @map("suspended_at") @db.Timestamptz(6)
  terminatedAt        DateTime? @map("terminated_at") @db.Timestamptz(6)
  version             Int       @default(1)
  /// Bumped by triggers whenever the tenant's entitlements, limits or status change; with the
  /// membership's permissions_version it makes the access token's pv (Part 10 §10.7.3).
  entitlementsVersion Int       @default(1) @map("entitlements_version")

  domains      TenantDomain[]
  entitlements TenantEntitlement[]
  limits       TenantLimit[]

  @@map("tenants")
  @@schema("platform")
}

model TenantDomain {
  id                String    @id @default(uuid(7)) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  domain            String    @unique
  kind              String
  verifiedAt        DateTime? @map("verified_at") @db.Timestamptz(6)
  certificateStatus String?   @map("certificate_status")
  /// A retired slug redirects until redirects_until and cannot be reused before reusable_after (§2.8).
  retiredAt         DateTime? @map("retired_at") @db.Timestamptz(6)
  redirectsUntil    DateTime? @map("redirects_until") @db.Timestamptz(6)
  reusableAfter     DateTime? @map("reusable_after") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("tenant_domains")
  @@schema("platform")
}

model CatalogueModule {
  key          String    @id
  name         String
  category     String
  groupName    String    @map("group_name")
  status       String
  sortOrder    Int       @map("sort_order")
  removedAt    DateTime? @map("removed_at") @db.Timestamptz(6)
  syncedAt     DateTime  @map("synced_at") @db.Timestamptz(6)
  /// Display fields staff edit in the console (Part 03 §3.11); null = the code's own.
  displayName  String?   @map("display_name")
  description  String?
  icon         String?
  displayOrder Int?      @map("display_order")
  updatedAt    DateTime? @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?   @map("updated_by") @db.Uuid

  features CatalogueFeature[]

  @@map("catalogue_modules")
  @@schema("platform")
}

model CatalogueFeature {
  key            String    @id
  moduleKey      String    @map("module_key")
  name           String
  release        String
  status         String
  alwaysOn       Boolean   @map("always_on")
  requires       String[]
  requiresAnyOf  String[]  @map("requires_any_of")
  recommends     String[]
  conflicts      String[]
  limits         String[]
  scopes         String[]
  menu           Json
  sortOrder      Int       @map("sort_order")
  removedAt      DateTime? @map("removed_at") @db.Timestamptz(6)
  syncedAt       DateTime  @map("synced_at") @db.Timestamptz(6)
  /// Display fields staff edit in the console (Part 03 §3.11); null = the code's own.
  displayName    String?   @map("display_name")
  description    String?
  icon           String?
  displayOrder   Int?      @map("display_order")
  /// Countries (ISO 3166-1 alpha-2) where the feature is offered; empty = everywhere.
  countries      String[]  @default([])
  /// ga / beta / preview / deprecated as staff present it; null = the registry's status.
  statusOverride String?   @map("status_override")
  updatedAt      DateTime? @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?   @map("updated_by") @db.Uuid

  module CatalogueModule @relation(fields: [moduleKey], references: [key])

  @@index([moduleKey])
  @@map("catalogue_features")
  @@schema("platform")
}

model CataloguePermission {
  key         String    @id
  moduleKey   String    @map("module_key")
  resource    String
  action      String
  featureKeys String[]  @map("feature_keys")
  sensitive   Boolean   @default(false)
  removedAt   DateTime? @map("removed_at") @db.Timestamptz(6)
  syncedAt    DateTime  @map("synced_at") @db.Timestamptz(6)

  @@index([moduleKey])
  @@map("catalogue_permissions")
  @@schema("platform")
}

model Plan {
  key           String    @id
  name          String
  tier          Int
  limits        Json      @default("{}")
  featureKeys   String[]  @map("feature_keys")
  prices        Json      @default("{}")
  visibility    String    @default("public")
  effectiveFrom DateTime  @default(now()) @map("effective_from") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?   @map("updated_by") @db.Uuid
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(6)
  version       Int       @default(1)

  @@map("plans")
  @@schema("platform")
}

model Addon {
  key           String    @id
  name          String
  limits        Json      @default("{}")
  featureKeys   String[]  @map("feature_keys")
  prices        Json      @default("{}")
  visibility    String    @default("public")
  effectiveFrom DateTime  @default(now()) @map("effective_from") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?   @map("updated_by") @db.Uuid
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(6)
  version       Int       @default(1)

  @@map("addons")
  @@schema("platform")
}

model IndustryTemplate {
  key         String
  version     String
  status      String
  definition  Json
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  publishedBy String?   @map("published_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?   @map("updated_by") @db.Uuid
  /// Optimistic concurrency for drafts (If-Match).
  revision    Int       @default(1)

  @@id([key, version])
  @@map("industry_templates")
  @@schema("platform")
}

/// Country rules as versioned data (Part 02 §2.6, Part 03 §3.11): draft → in review →
/// published → deprecated; old versions stay for recalculating past periods.
model CountryPack {
  country       String    @db.Char(2)
  version       String
  status        String
  effectiveFrom DateTime  @map("effective_from") @db.Date
  data          Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?   @map("updated_by") @db.Uuid
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  publishedBy   String?   @map("published_by") @db.Uuid
  revision      Int       @default(1)

  @@id([country, version])
  @@map("country_packs")
  @@schema("platform")
}

/// Four-eyes (◐ in Part 03 §3.2.1): an action that runs only after a second eligible staff
/// member approves it. Nobody approves their own request.
model StaffApproval {
  id           String    @id @default(uuid(7)) @db.Uuid
  action       String
  targetType   String    @map("target_type")
  targetId     String    @map("target_id")
  payload      Json      @default("{}")
  reason       String
  status       String    @default("pending")
  requestedBy  String    @map("requested_by") @db.Uuid
  requestedAt  DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  decidedBy    String?   @map("decided_by") @db.Uuid
  decidedAt    DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionNote String?   @map("decision_note")
  executedAt   DateTime? @map("executed_at") @db.Timestamptz(6)
  result       Json?

  requester StaffUser  @relation("ApprovalRequester", fields: [requestedBy], references: [id])
  decider   StaffUser? @relation("ApprovalDecider", fields: [decidedBy], references: [id])

  @@index([status, requestedAt])
  @@index([targetType, targetId])
  @@map("staff_approvals")
  @@schema("platform")
}

model TenantEntitlement {
  tenantId   String    @map("tenant_id") @db.Uuid
  featureKey String    @map("feature_key")
  state      String
  source     String
  limits     Json      @default("{}")
  validFrom  DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validTo    DateTime? @map("valid_to") @db.Timestamptz(6)
  reason     String?
  changedBy  String    @map("changed_by") @db.Uuid
  changedAt  DateTime  @default(now()) @map("changed_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, featureKey, source])
  @@map("tenant_entitlements")
  @@schema("platform")
}

model TenantLimit {
  tenantId  String    @map("tenant_id") @db.Uuid
  limitKey  String    @map("limit_key")
  value     BigInt
  source    String
  validTo   DateTime? @map("valid_to") @db.Timestamptz(6)
  reason    String?
  changedBy String    @map("changed_by") @db.Uuid
  changedAt DateTime  @default(now()) @map("changed_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, limitKey, source])
  @@map("tenant_limits")
  @@schema("platform")
}

model EntitlementChangeSet {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  items       Json
  mode        String
  effectiveAt DateTime  @map("effective_at") @db.Timestamptz(6)
  reason      String
  requestedBy String    @map("requested_by") @db.Uuid
  approvedBy  String?   @map("approved_by") @db.Uuid
  appliedAt   DateTime? @map("applied_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@map("entitlement_change_sets")
  @@schema("platform")
}

model StaffUser {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String
  emailNormalized String    @unique @map("email_normalized")
  name            String
  status          String    @default("active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastSignInAt    DateTime? @map("last_sign_in_at") @db.Timestamptz(6)
  version         Int       @default(1)

  roles         StaffRoleAssignment[]
  credentials   StaffCredential[]
  mfaFactors    StaffMfaFactor[]
  recoveryCodes StaffRecoveryCode[]
  sessions      StaffSession[]
  setupTokens   StaffSetupToken[]
  requested     StaffApproval[]       @relation("ApprovalRequester")
  decided       StaffApproval[]       @relation("ApprovalDecider")

  @@map("staff_users")
  @@schema("platform")
}

model StaffRole {
  key         String @id
  name        String
  description String

  assignments StaffRoleAssignment[]

  @@map("staff_roles")
  @@schema("platform")
}

model StaffRoleAssignment {
  staffUserId String   @map("staff_user_id") @db.Uuid
  roleKey     String   @map("role_key")
  assignedBy  String?  @map("assigned_by") @db.Uuid
  assignedAt  DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  staffUser StaffUser @relation(fields: [staffUserId], references: [id])
  role      StaffRole @relation(fields: [roleKey], references: [key])

  @@id([staffUserId, roleKey])
  @@map("staff_role_assignments")
  @@schema("platform")
}

/// Append-only, hash-chained (Part 03 §3.17). Written only through platform.append_audit().
model PlatformAuditLog {
  seq            BigInt   @unique @default(autoincrement())
  id             String   @id @db.Uuid
  at             DateTime @db.Timestamptz(6)
  actorStaffId   String?  @map("actor_staff_id") @db.Uuid
  action         String
  targetTenantId String?  @map("target_tenant_id") @db.Uuid
  targetType     String?  @map("target_type")
  targetId       String?  @map("target_id")
  before         Json?
  after          Json?
  reason         String?
  correlationId  String?  @map("correlation_id")
  result         String   @default("success")
  prevHash       Bytes?   @map("prev_hash")
  hash           Bytes

  @@index([targetTenantId])
  @@map("platform_audit_log")
  @@schema("platform")
}

// ── Staff sign-in (D5): built-in accounts with mandatory TOTP, stored apart from members ──
// Same shape as the identity tables; the field is `userId` so one auth service serves both.

model StaffCredential {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @map("staff_user_id") @db.Uuid
  kind           String   @default("password")
  hash           String
  algorithm      String
  params         Json     @default("{}")
  singleFactorOk Boolean  @default(false) @map("single_factor_ok")
  changedAt      DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  user StaffUser @relation(fields: [userId], references: [id])

  @@unique([userId, kind])
  @@map("staff_credentials")
  @@schema("platform")
}

model StaffMfaFactor {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("staff_user_id") @db.Uuid
  kind         String
  secret       Bytes?
  publicKey    Bytes?    @map("public_key")
  label        String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(6)
  confirmedAt  DateTime? @map("confirmed_at") @db.Timestamptz(6)
  lastUsedStep BigInt?   @map("last_used_step")
  disabledAt   DateTime? @map("disabled_at") @db.Timestamptz(6)

  user StaffUser @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("staff_mfa_factors")
  @@schema("platform")
}

model StaffRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("staff_user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  user StaffUser @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("staff_recovery_codes")
  @@schema("platform")
}

model StaffSession {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("staff_user_id") @db.Uuid
  client        String    @default("web")
  ip            String?   @db.Inet
  userAgent     String?   @map("user_agent")
  deviceHash    String?   @map("device_hash")
  amr           String[]  @default([])
  mfaVerifiedAt DateTime? @map("mfa_verified_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason  String?   @map("revoke_reason")

  user          StaffUser           @relation(fields: [userId], references: [id])
  refreshTokens StaffRefreshToken[]

  @@index([userId])
  @@map("staff_sessions")
  @@schema("platform")
}

model StaffRefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  issuedAt  DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  session StaffSession @relation(fields: [sessionId], references: [id])

  @@index([familyId])
  @@map("staff_refresh_tokens")
  @@schema("platform")
}

/// One-time links for staff: the first Platform Owner's setup link, and password resets.
model StaffSetupToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("staff_user_id") @db.Uuid
  kind      String    @default("setup")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user StaffUser @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("staff_setup_tokens")
  @@schema("platform")
}

model StaffLoginAttempt {
  id              String   @id @default(uuid(7)) @db.Uuid
  emailNormalized String   @map("email_normalized")
  ip              String?  @db.Inet
  at              DateTime @default(now()) @db.Timestamptz(6)
  success         Boolean
  reason          String?

  @@index([emailNormalized, at])
  @@map("staff_login_attempts")
  @@schema("platform")
}

model FeatureFlag {
  key         String   @id
  description String
  enabled     Boolean  @default(false)
  /// Targeting: { "tenants": [...], "plans": [...], "industries": [...], "percentage": 0-100 }
  rules       Json     @default("{}")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?  @map("updated_by") @db.Uuid

  @@map("feature_flags")
  @@schema("platform")
}

// ─────────────────────────────── identity (global accounts, §11.3) ───────────────────────────────

/// One account per person and kind: a teacher who is also a parent has a member and a portal
/// account with the same e-mail (gap G14, Part 05 §5.1).
model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String
  emailNormalized String    @map("email_normalized")
  accountKind     String    @default("member") @map("account_kind")
  name            String
  locale          String    @default("en")
  status          String    @default("active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastSignInAt    DateTime? @map("last_sign_in_at") @db.Timestamptz(6)
  version         Int       @default(1)

  credentials    Credential[]
  mfaFactors     MfaFactor[]
  recoveryCodes  RecoveryCode[]
  sessions       Session[]
  passwordResets PasswordReset[]
  emailChanges   EmailChange[]
  memberships    Membership[]

  @@unique([emailNormalized, accountKind])
  @@map("users")
  @@schema("identity")
}

model Credential {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  kind           String   @default("password")
  hash           String
  algorithm      String
  params         Json     @default("{}")
  /// The password meets the single-factor length (15), so MFA may be turned off (gap G16).
  singleFactorOk Boolean  @default(false) @map("single_factor_ok")
  changedAt      DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, kind])
  @@map("credentials")
  @@schema("identity")
}

model MfaFactor {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  kind         String
  /// TOTP secret, encrypted by the application.
  secret       Bytes?
  publicKey    Bytes?    @map("public_key")
  label        String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(6)
  /// Set when the first code is confirmed; until then the factor is an enrolment in progress.
  confirmedAt  DateTime? @map("confirmed_at") @db.Timestamptz(6)
  /// Last TOTP time step accepted, so a code cannot be used twice.
  lastUsedStep BigInt?   @map("last_used_step")
  disabledAt   DateTime? @map("disabled_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("mfa_factors")
  @@schema("identity")
}

model RecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("recovery_codes")
  @@schema("identity")
}

model Session {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  audience      String
  membershipId  String?   @map("membership_id") @db.Uuid
  deviceLabel   String?   @map("device_label")
  /// web (refresh token in a cookie) or desktop (kept by the main process).
  client        String    @default("web")
  ip            String?   @db.Inet
  userAgent     String?   @map("user_agent")
  /// SHA-256 of the browser's or desktop's device id, to notice a new device.
  deviceHash    String?   @map("device_hash")
  /// Authentication methods of the sign-in: pwd, otp, recovery.
  amr           String[]  @default([])
  /// Last MFA check, for step-up on sensitive actions.
  mfaVerifiedAt DateTime? @map("mfa_verified_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  /// Absolute end of the session (30 days at most).
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason  String?   @map("revoke_reason")

  user          User           @relation(fields: [userId], references: [id])
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
  @@schema("identity")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  issuedAt  DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  session Session @relation(fields: [sessionId], references: [id])

  @@index([familyId])
  @@map("refresh_tokens")
  @@schema("identity")
}

/// Tenant-owned: Row-Level Security applies. Before a tenant is known, the invitation is found
/// through identity.invitation_by_token_hash() (ADR 0006).
model Invitation {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  membershipId String    @map("membership_id") @db.Uuid
  email        String
  kind         String
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  sentCount    Int       @default(0) @map("sent_count")
  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid

  membership Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, membershipId])
  @@map("invitations")
  @@schema("identity")
}

model PasswordReset {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// reset (forgot password), lockout (the "this wasn't me" link) or setup (first password).
  kind      String    @default("reset")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_resets")
  @@schema("identity")
}

/// A pending change of e-mail address, confirmed from a link sent to the new address.
model EmailChange {
  id                 String    @id @default(uuid(7)) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  newEmail           String    @map("new_email")
  newEmailNormalized String    @map("new_email_normalized")
  tokenHash          String    @unique @map("token_hash")
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt             DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("email_changes")
  @@schema("identity")
}

model LoginAttempt {
  id              String   @id @default(uuid(7)) @db.Uuid
  emailNormalized String   @map("email_normalized")
  ip              String?  @db.Inet
  at              DateTime @default(now()) @db.Timestamptz(6)
  success         Boolean
  reason          String?

  @@index([emailNormalized, at])
  @@map("login_attempts")
  @@schema("identity")
}

// ─────────────────────────────── app (tenant data, §11.4; RLS on every table) ───────────────────────────────

model Membership {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  /// Empty for device users (Part 04 §4.8.7).
  userId             String?   @map("user_id") @db.Uuid
  kind               String
  displayName        String    @map("display_name")
  status             String
  /// Same-tenant reference: composite FK written in SQL (migration tenant_safe_references), not a Prisma relation, because Prisma cannot model an optional reference whose key includes the required tenant_id.
  primaryBranchId    String?   @map("primary_branch_id") @db.Uuid
  /// Same-tenant reference: composite FK written in SQL (migration tenant_safe_references), not a Prisma relation, because Prisma cannot model an optional reference whose key includes the required tenant_id.
  departmentId       String?   @map("department_id") @db.Uuid
  /// The People module's employee record; its FK arrives with that table.
  employeeId         String?   @map("employee_id") @db.Uuid
  startsOn           DateTime? @map("starts_on") @db.Date
  endsOn             DateTime? @map("ends_on") @db.Date
  permissionsVersion Int       @default(1) @map("permissions_version")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy          String?   @map("created_by") @db.Uuid
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy          String?   @map("updated_by") @db.Uuid
  version            Int       @default(1)

  user        User?                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles       MembershipRole[]
  exceptions  MembershipException[]
  teams       TeamMember[]
  invitations Invitation[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, primaryBranchId])
  @@index([tenantId, departmentId])
  @@map("memberships")
  @@schema("app")
}

model Role {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  key          String
  name         String
  description  String?
  origin       String
  templateKey  String?   @map("template_key")
  isCustomised Boolean   @default(false) @map("is_customised")
  isProtected  Boolean   @default(false) @map("is_protected")
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?   @map("updated_by") @db.Uuid
  version      Int       @default(1)

  grants  RoleGrant[]
  members MembershipRole[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("roles")
  @@schema("app")
}

model RoleGrant {
  tenantId      String   @map("tenant_id") @db.Uuid
  roleId        String   @map("role_id") @db.Uuid
  permissionKey String   @map("permission_key")
  scopeType     String   @map("scope_type")
  /// For example { "max_discount_pct": 10 } (Part 04 §4.9.5).
  thresholds    Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?  @map("created_by") @db.Uuid

  role Role @relation(fields: [tenantId, roleId], references: [tenantId, id])

  @@id([tenantId, roleId, permissionKey])
  @@map("role_grants")
  @@schema("app")
}

model MembershipRole {
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  /// { "branch_ids": [...], "section_ids": [...], ... } (Part 11 §11.8).
  scopeValues  Json     @default("{}") @map("scope_values")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?  @map("created_by") @db.Uuid

  membership Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id])
  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id])

  @@id([tenantId, membershipId, roleId])
  @@map("membership_roles")
  @@schema("app")
}

model MembershipException {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  membershipId  String   @map("membership_id") @db.Uuid
  permissionKey String   @map("permission_key")
  effect        String
  scopeType     String?  @map("scope_type")
  scopeValues   Json     @default("{}") @map("scope_values")
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(6)
  reason        String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?  @map("created_by") @db.Uuid

  membership Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id])

  @@index([tenantId, membershipId])
  @@map("membership_exceptions")
  @@schema("app")
}

model LegalEntity {
  id                   String    @id @default(uuid(7)) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  legalName            String    @map("legal_name")
  taxIds               Json      @default("{}") @map("tax_ids")
  baseCurrency         String    @map("base_currency") @db.Char(3)
  fiscalYearStartMonth Int       @default(7) @map("fiscal_year_start_month")
  address              Json      @default("{}")
  archivedAt           DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy            String?   @map("created_by") @db.Uuid
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy            String?   @map("updated_by") @db.Uuid
  version              Int       @default(1)

  branches Branch[]

  @@unique([tenantId, id])
  @@map("legal_entities")
  @@schema("app")
}

model Branch {
  id                  String    @id @default(uuid(7)) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  legalEntityId       String    @map("legal_entity_id") @db.Uuid
  name                String
  code                String
  type                String
  address             Json      @default("{}")
  phone               String?
  timeZone            String?   @map("time_zone")
  status              String    @default("active")
  /// Same-tenant reference: composite FK written in SQL (migration tenant_safe_references), not a Prisma relation, because Prisma cannot model an optional reference whose key includes the required tenant_id.
  managerMembershipId String?   @map("manager_membership_id") @db.Uuid
  archivedAt          DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy           String?   @map("created_by") @db.Uuid
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy           String?   @map("updated_by") @db.Uuid
  version             Int       @default(1)

  legalEntity LegalEntity @relation(fields: [tenantId, legalEntityId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, managerMembershipId])
  @@map("branches")
  @@schema("app")
}

model Department {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  name             String
  code             String
  /// Same-tenant reference: composite FK written in SQL (migration tenant_safe_references), not a Prisma relation, because Prisma cannot model an optional reference whose key includes the required tenant_id.
  parentId         String?   @map("parent_id") @db.Uuid
  /// Same-tenant reference: composite FK written in SQL (migration tenant_safe_references), not a Prisma relation, because Prisma cannot model an optional reference whose key includes the required tenant_id.
  headMembershipId String?   @map("head_membership_id") @db.Uuid
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy        String?   @map("created_by") @db.Uuid
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy        String?   @map("updated_by") @db.Uuid
  version          Int       @default(1)

  @@unique([tenantId, id])
  @@unique([tenantId, code])
