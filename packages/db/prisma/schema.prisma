  membershipId String   @map("membership_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  team       Team       @relation(fields: [tenantId, teamId], references: [tenantId, id])
  membership Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id])

  @@id([tenantId, teamId, membershipId])
  @@map("team_members")
  @@schema("app")
}

model Position {
  id                  String    @id @default(uuid(7)) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  title               String
  grade               String?
  /// Same-tenant reference: composite FK written in SQL (migration tenant_safe_references), not a Prisma relation, because Prisma cannot model an optional reference whose key includes the required tenant_id.
  departmentId        String?   @map("department_id") @db.Uuid
  /// Same-tenant reference: composite FK written in SQL (migration tenant_safe_references), not a Prisma relation, because Prisma cannot model an optional reference whose key includes the required tenant_id.
  reportsToPositionId String?   @map("reports_to_position_id") @db.Uuid
  archivedAt          DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy           String?   @map("created_by") @db.Uuid
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy           String?   @map("updated_by") @db.Uuid
  version             Int       @default(1)

  @@unique([tenantId, id])
  @@index([tenantId, departmentId])
  @@index([tenantId, reportsToPositionId])
  @@map("positions")
  @@schema("app")
}

/// Settings inheritance (Part 02 §2.13). scope_id is the tenant id for company-wide values.
model Setting {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  scopeType String   @map("scope_type")
  scopeId   String   @map("scope_id") @db.Uuid
  moduleKey String   @map("module_key")
  key       String
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)

  @@unique([tenantId, scopeType, scopeId, moduleKey, key])
  @@map("settings")
  @@schema("app")
}

/// Append-only (Part 04 §4.19): UPDATE, DELETE and TRUNCATE are refused.
model AuditLog {
  id                String   @id @default(uuid(7)) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  at                DateTime @default(now()) @db.Timestamptz(6)
  actorMembershipId String?  @map("actor_membership_id") @db.Uuid
  actorStaffId      String?  @map("actor_staff_id") @db.Uuid
  supportGrantId    String?  @map("support_grant_id") @db.Uuid
  action            String
  recordType        String   @map("record_type")
  recordId          String?  @map("record_id")
  before            Json?
  after             Json?
  ip                String?  @db.Inet
  deviceId          String?  @map("device_id") @db.Uuid
  correlationId     String?  @map("correlation_id")

  @@index([tenantId, at])
  @@index([tenantId, recordType, recordId])
  @@map("audit_log")
  @@schema("app")
}

/// Domain events written in the same transaction as the change (Part 10 §10.9.1).
model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  type          String
  aggregateType String?   @map("aggregate_type")
  aggregateId   String?   @map("aggregate_id")
  payload       Json      @default("{}")
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  dispatchedAt  DateTime? @map("dispatched_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")

  @@index([dispatchedAt, occurredAt])
  @@map("outbox")
  @@schema("app")
}

model ProcessedEvent {
  tenantId    String   @map("tenant_id") @db.Uuid
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([tenantId, consumer, eventId])
  @@map("processed_events")
  @@schema("app")
}

/// Installer state per module and tenant (Part 10 §10.8).
model TenantModuleState {
  tenantId  String    @map("tenant_id") @db.Uuid
  moduleKey String    @map("module_key")
  status    String
  version   String
  lastRunAt DateTime? @map("last_run_at") @db.Timestamptz(6)
  error     String?

  @@id([tenantId, moduleKey])
  @@map("tenant_module_state")
  @@schema("app")
}
