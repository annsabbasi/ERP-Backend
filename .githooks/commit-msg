#!/bin/sh
# Refuses a commit whose message has a Co-authored-by line or whose author or
# committer e-mail is not the repository owner's (docs/adr/0004-direct-commits-to-main.md).
# Enable once per clone:  git config core.hooksPath .githooks
# CI job commit-hygiene applies the same rules to every commit on main.

allowed='annsabbasi54@gmail.com'

# Every line of the message file is checked, comment lines and anything below a scissors
# line included, because `git commit -F` keeps those lines in the commit. With
# `git commit -v` a diff that contains the phrase is refused too; commit without -v then.
if grep -qi 'co-authored-by' "$1"; then
  echo 'commit-msg: refused. The message contains "Co-authored-by"; remove that line.' >&2
  exit 1
fi

for role in AUTHOR COMMITTER; do
  email=$(git var "GIT_${role}_IDENT" | sed -n 's/.*<\(.*\)>.*/\1/p')
  if [ "$email" != "$allowed" ]; then
    echo "commit-msg: refused. The $(echo "$role" | tr 'A-Z' 'a-z') e-mail is <$email>; it must be <$allowed>." >&2
    echo "Fix it with: git config user.email $allowed" >&2
    exit 1
  fi
done
