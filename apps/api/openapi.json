{
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/flags": {
      "get": {
        "operationId": "FlagsController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Release flags and whether each is on",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "flags": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "boolean"
                      }
                    }
                  },
                  "required": [
                    "flags"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "tags": [
          "flags"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The process is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "HealthController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Database and Redis answer",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "error"
                      ]
                    },
                    "db": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "error"
                      ]
                    },
                    "redis": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "error"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "db",
                    "redis"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Database or Redis does not answer",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "error"
                      ]
                    },
                    "db": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "error"
                      ]
                    },
                    "redis": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "error"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "db",
                    "redis"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "ERP System API",
    "description": "Company API under /api/v1 (Part 11 §11.10). Errors are RFC 9457 problem details (application/problem+json) with a stable code.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "feature_not_entitled",
              "permission_denied",
              "not_found",
              "validation_failed",
              "conflict",
              "limit_reached",
              "period_closed",
              "tenant_read_only",
              "approval_required",
              "rate_limited",
              "unauthenticated",
              "internal_error"
            ]
          },
          "correlation_id": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "message"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "additionalProperties": false
      }
    }
  }
}
