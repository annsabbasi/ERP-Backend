{
  "name": "@erp/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build && node dist/generate-openapi.js",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "auth:init": "node scripts/auth-init.mjs"
  },
  "dependencies": {
    "@erp/contracts": "workspace:*",
    "@erp/db": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@node-rs/argon2": "2.2.2",
    "@zxcvbn-ts/language-common": "4.1.3",
    "bullmq": "6.4.0",
    "cookie-parser": "1.4.7",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "nestjs-cls": "7.0.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@erp/config": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.13.0",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": ".",
    "testRegex": ".*\\.(e2e-)?spec\\.ts$",
    "setupFiles": [
      "<rootDir>/test/local-only.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ],
      "^.+\\.js$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true,
            "module": "commonjs",
            "target": "es2022",
            "isolatedModules": true
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!\\.pnpm/jose@|jose/)"
    ]
  }
}
