{
  "name": "erp-backend",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "local:up": "docker compose -f infra/docker-compose.yml up -d --wait && turbo run build --filter=@erp/db && pnpm --filter @erp/db db:migrate:deploy && pnpm --filter @erp/db db:local-roles && pnpm --filter @erp/db db:seed",
    "local:down": "docker compose -f infra/docker-compose.yml down",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write ."
  },
  "prettier": "@erp/config/prettier",
  "devDependencies": {
    "@erp/config": "workspace:*",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
