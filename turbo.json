{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "CI",
    "LOCAL_ONLY",
    "DATABASE_URL",
    "DIRECT_URL",
    "OPS_DATABASE_URL",
    "AUTH_DATABASE_URL",
    "REDIS_URL",
    "DATABASE_CA_CERT",
    "FEATURE_FLAGS",
    "PROBLEM_TYPE_BASE",
    "TEST_PG_SERVER",
    "TEST_APP_USER_PASSWORD",
    "TEST_APP_OPS_PASSWORD",
    "TEST_APP_AUTH_PASSWORD",
    "TEST_REDIS_URL"
  ],
  "tasks": {
    "generate": {
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**", "openapi.json"]
    },
    "lint": {
      "dependsOn": ["generate"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "generate"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
